@model IEnumerable<DoAnLapTrinhWeb.Models.Accommodation>
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

<div class="container mt-5 mb-5" style="min-height: 60vh;">
    <h3 class="fw-bold mb-4 border-bottom pb-2">Kết quả tìm kiếm (@(ViewBag.TotalCount ?? 0) phòng)</h3>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        <button data-favorite-room-id="@room.Id" onclick="toggleGlobalFavorite(@room.Id, this)" class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle shadow-sm" style="z-index: 10;">
                            <i class="far fa-heart text-muted"></i>
                        </button>
                        @{
                            var firstImage = (room.Images != null && room.Images.Any()) ? room.Images.First().ImageUrl : "/images/default-room.jpg";
                        }
                        <img src="@firstImage" class="card-img-top" style="height: 220px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title text-truncate fw-bold">@room.Title</h5>
                            <p class="card-text text-danger fw-bold fs-5">@room.Price.ToString("N0") VNĐ</p>
                        </div>
                        <div class="card-footer bg-white border-top-0 pb-3">
                            <a href="/Accommodation/Details/@room.Id" class="btn btn-outline-primary w-100 rounded-pill">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            var currentPage = (int)ViewBag.CurrentPage;
            var totalPages = (int)ViewBag.TotalPages;

            <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Search", new { cityId = ViewBag.SearchCityId, districtId = ViewBag.SearchDistrictId, priceRange = ViewBag.SearchPriceRange, keyword = ViewBag.SearchKeyword, page = currentPage - 1 })">« Trang trước</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Search", new { cityId = ViewBag.SearchCityId, districtId = ViewBag.SearchDistrictId, priceRange = ViewBag.SearchPriceRange, keyword = ViewBag.SearchKeyword, page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Search", new { cityId = ViewBag.SearchCityId, districtId = ViewBag.SearchDistrictId, priceRange = ViewBag.SearchPriceRange, keyword = ViewBag.SearchKeyword, page = currentPage + 1 })">Trang sau »</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <h4 class="text-muted">Không tìm thấy phòng trọ nào phù hợp với yêu cầu của bạn.</h4>
            <a href="/" class="btn btn-primary mt-3">Thử tìm kiếm lại</a>
        </div>
    }
</div>
