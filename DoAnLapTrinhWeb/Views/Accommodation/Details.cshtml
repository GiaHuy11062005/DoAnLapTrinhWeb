@model DoAnLapTrinhWeb.Models.Accommodation
@{
    ViewData["Title"] = Model.Title;
    
    // Chuỗi địa chỉ chuẩn bị cho Google Maps (Sử dụng Model.District?.Name để lấy tên an toàn)
    string fullAddress = $"{Model.SpecificAddress}, {Model.District?.Name}, {Model.City?.Name}";
    
    // Đã sửa thành URL API tìm kiếm vị trí chuẩn của Google Maps
    string googleMapsLink = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(fullAddress)}";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-md-7">
            @if (Model.Images != null && Model.Images.Any())
            {
                <div id="roomCarousel" class="carousel slide shadow-sm rounded" data-bs-ride="carousel">
                    <div class="carousel-inner rounded">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.Images.ElementAt(i).ImageUrl" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="Hình phòng">
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>
            }
        </div>

        <div class="col-md-5">
            <h2 class="fw-bold text-primary">@Model.Title</h2>
            <p class="text-muted"><i class="fas fa-map-marker-alt text-danger"></i> @fullAddress</p>
            
            <a href="@googleMapsLink" target="_blank" class="btn btn-outline-success mb-3 w-100 fw-bold">
                <i class="fas fa-map-marked-alt"></i> Bấm để xem vị trí trên Google Maps
            </a>

            <h3 class="text-danger fw-bold mb-3">@Model.Price.ToString("N0") VNĐ/tháng</h3>
            
            <ul class="list-group mb-3 shadow-sm">
                <li class="list-group-item"><i class="fas fa-expand-arrows-alt text-primary"></i> <strong>Diện tích:</strong> @Model.Area m²</li>
                <li class="list-group-item"><i class="fas fa-motorcycle text-primary"></i> <strong>Bãi giữ xe:</strong> @(Model.HasParking ? "Có" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-paw text-primary"></i> <strong>Nuôi thú cưng:</strong> @(Model.AllowsPets ? "Cho phép" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-wifi text-primary"></i> <strong>WiFi tốc độ cao:</strong> @(Model.HasHighSpeedWifi ? "Có" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-snowflake text-primary"></i> <strong>Máy lạnh Inverter:</strong> @(Model.HasInverterAirConditioner ? "Có" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-soap text-primary"></i> <strong>Máy giặt sấy:</strong> @(Model.HasWasherDryer ? "Có" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-shield-halved text-primary"></i> <strong>An ninh 24/7:</strong> @(Model.Has24HourSecurity ? "Có" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-square-parking text-primary"></i> <strong>Hầm để xe:</strong> @(Model.HasBasementParking ? "Có" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-elevator text-primary"></i> <strong>Thang máy:</strong> @(Model.HasElevator ? "Có" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-temperature-low text-primary"></i> <strong>Tủ lạnh:</strong> @(Model.HasRefrigerator ? "Có" : "Không")</li>
                <li class="list-group-item"><i class="fas fa-building text-primary"></i> <strong>Ban công:</strong> @(Model.HasBalcony ? "Có" : "Không")</li>
                <li class="list-group-item">
                    <i class="fas fa-phone-alt text-success"></i>
                    <strong>Liên hệ chủ trọ:</strong>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="fw-bold fs-5 text-success">@Model.ContactPhone</span>
                    }
                    else
                    {
                        <a href="/Auth/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)" class="fw-bold text-primary text-decoration-none">
                            Đăng nhập để xem số điện thoại
                        </a>
                    }
                </li>
            </ul>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <button onclick="toggleGlobalFavorite(@Model.Id, this)" class="btn btn-danger w-100">
                    <i class="far fa-heart"></i> Lưu vào Yêu thích
                </button>
            }
            else
            {
                <a href="/Auth/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)" class="btn btn-danger w-100">
                    <i class="fas fa-right-to-bracket"></i> Đăng nhập để lưu phòng
                </a>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3"><i class="fas fa-route text-primary"></i> Tiện ích di chuyển</h5>
                        
                        @if (!string.IsNullOrEmpty(ViewBag.UserDestination))
                        {
                            string fullOriginAddress = $"{Model.SpecificAddress}, {Model.District?.Name}, {Model.City?.Name}";
                            
                            string origin = Uri.EscapeDataString(fullOriginAddress);
                            string destination = Uri.EscapeDataString(ViewBag.UserDestination);
                            
                            // Đã sửa lại URL thành link chuẩn của Google Maps Directions API
                            string mapUrl = $"https://www.google.com/maps/dir/?api=1&origin={origin}&destination={destination}";
                            
                            <a href="@mapUrl" target="_blank" class="btn btn-outline-primary w-100 fw-bold rounded-pill">
                                <i class="fas fa-map-marked-alt me-2"></i> Xem đường đi từ Trọ đến Trường/Chỗ làm
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-warning small mb-3">
                                Hệ thống chưa có thông tin địa chỉ trường học / công ty của bạn để tính quãng đường.
                            </div>
                            <a href="/Profile" class="btn btn-warning w-100 fw-bold rounded-pill">
                                <i class="fas fa-edit me-2"></i> Cập nhật địa chỉ để xem lộ trình
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h4 class="fw-bold border-bottom pb-2">Mô tả chi tiết</h4>
            <p style="white-space: pre-line;" class="text-justify mt-3">@Model.Description</p>
        </div>
    </div>
</div>
