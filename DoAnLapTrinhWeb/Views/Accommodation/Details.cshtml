@model DoAnLapTrinhWeb.Models.Accommodation
@{
    ViewData["Title"] = Model.Title;
    var images = Model.Images?.Where(image => !string.IsNullOrWhiteSpace(image.ImageUrl)).ToList() ?? new();
    var fullAddress = $"{Model.SpecificAddress}, {Model.District?.Name}, {Model.City?.Name}";
    var googleMapsLink = GoogleMapsUrlHelper.GetDetailedUrl(Model.GoogleMapsUrl, fullAddress);
    var googleMapsEmbedUrl = GoogleMapsUrlHelper.GetEmbedUrl(Model.GoogleMapsUrl, fullAddress);
    var hasRoomCoordinates = GoogleMapsUrlHelper.TryGetCoordinates(Model.GoogleMapsUrl, out var roomLatitude, out var roomLongitude);
    var ownerName = Model.Owner?.FullName ?? "Chủ trọ";
    var ownerInitial = ownerName.Substring(0, 1).ToUpper();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    // Lấy ID của người dùng đang đăng nhập để kiểm tra xem họ có phải chủ bài đăng không
    var currentUserId = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int? activeRentalAccommodationId = ViewBag.ActiveRentalAccommodationId == null
        ? null
        : (int)ViewBag.ActiveRentalAccommodationId;
    var activeRentalTitle = ViewBag.ActiveRentalTitle as string;
    var userHasActiveRental = User.IsInRole("User") && activeRentalAccommodationId.HasValue;
    var userIsRentingThisRoom = activeRentalAccommodationId == Model.Id;
    var roomReviews = ViewBag.RoomReviews as List<AccommodationReview> ?? new();
    var averageRating = Convert.ToDouble(ViewBag.AverageRating ?? 0);
    var reviewCount = Convert.ToInt32(ViewBag.ReviewCount ?? roomReviews.Count);
    int? reviewableRentalRequestId = ViewBag.ReviewableRentalRequestId == null
        ? null
        : (int)ViewBag.ReviewableRentalRequestId;

    var amenities = new[]
    {
        (Model.HasParking, "fa-motorcycle", "Bãi giữ xe"),
        (Model.AllowsPets, "fa-paw", "Cho nuôi thú cưng"),
        (Model.HasHighSpeedWifi, "fa-wifi", "WiFi tốc độ cao"),
        (Model.HasInverterAirConditioner, "fa-snowflake", "Máy lạnh Inverter"),
        (Model.HasWasherDryer, "fa-soap", "Máy giặt sấy"),
        (Model.Has24HourSecurity, "fa-shield-halved", "An ninh 24/7"),
        (Model.HasBasementParking, "fa-square-parking", "Hầm để xe"),
        (Model.HasElevator, "fa-elevator", "Thang máy"),
        (Model.HasRefrigerator, "fa-temperature-low", "Tủ lạnh"),
        (Model.HasBalcony, "fa-building", "Ban công")
    }.Where(item => item.Item1).ToList();
}

<div class="room-detail-page">
    <div class="container room-detail-shell">
        <button type="button" class="room-back-button" onclick="goBackFromRoom()">
            <i class="fas fa-arrow-left"></i> Quay lại
        </button>

        @if (ViewBag.UserDestination != null)
        {
            <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="background-color: rgba(13, 110, 253, 0.08);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <h6 class="fw-bold text-dark mb-1"><i class="fas fa-route text-primary me-2"></i> Đường đến trường học / nơi làm việc của bạn</h6>
                        <p class="text-muted small mb-0">Từ vị trí trọ đến: <strong class="text-dark">@ViewBag.UserDestination</strong></p>
                    </div>
                    <a href="https://www.google.com/maps/dir/?api=1&origin=@Uri.EscapeDataString(fullAddress)&destination=@Uri.EscapeDataString(ViewBag.UserDestination)"
                       target="_blank" class="btn btn-primary rounded-pill shadow-sm px-4 fw-medium">
                        <i class="fas fa-map-marked-alt me-1"></i> Xem lộ trình chi tiết <i class="fas fa-external-link-alt ms-1 small"></i>
                    </a>
                </div>
            </div>
        }

        <div class="room-detail-layout">
            <main class="room-detail-main">
                <section class="room-gallery">
                    @if (images.Any())
                    {
                        <div class="room-gallery__primary">
                            <img id="roomGalleryMainImage" src="@images[0].ImageUrl" alt="@Model.Title" />
                            <span class="room-gallery__status @(Model.IsApproved ? "" : "is-pending")">
                                <i class="fas @(Model.IsApproved ? "fa-circle-check" : "fa-clock")"></i>
                                @(Model.IsApproved ? "Đã xác minh" : "Đang chờ duyệt")
                            </span>
                        </div>
                        <div class="room-gallery__rail">
                            @foreach (var image in images.Skip(1).Take(4))
                            {
                                <button type="button" class="room-gallery__thumb" data-gallery-image="@image.ImageUrl">
                                    <img src="@image.ImageUrl" alt="Ảnh khác của @Model.Title" />
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="room-gallery__empty"><i class="far fa-image"></i><span>Chưa có hình ảnh phòng</span></div>
                    }
                </section>

                <section class="room-detail-card room-summary-card">
                    <div class="room-summary-card__heading">
                        <div>
                            <h1>@Model.Title</h1>
                            <p><i class="fas fa-location-dot"></i> @fullAddress</p>
                        </div>
                        <div class="room-summary-card__price">
                            <strong>@Model.Price.ToString("N0")đ</strong>
                            <span>/tháng</span>
                        </div>
                    </div>

                    <div class="room-facts">
                        <span>
                            <i class="fas fa-home text-success"></i>
                            <strong>
                                @(Model.AccommodationType == "NhaNguyenCan" ? "Nhà nguyên căn" :
                                  Model.AccommodationType == "CanHo" ? "Căn hộ Mini" :
                                  Model.AccommodationType == "SleepBox" ? "Ký túc xá" : "Phòng trọ")
                            </strong> Loại hình
                        </span>

                        <span><i class="fas fa-expand"></i><strong>@Model.Area m²</strong> Diện tích</span>
                        <span><i class="fas fa-user-group"></i><strong>@Model.MaxOccupants người</strong> Tối đa</span>
                        <span><i class="fas fa-calendar-day"></i><strong>@Model.CreatedAt.ToString("dd/MM/yyyy")</strong> Ngày đăng</span>
                        <span><i class="fas fa-circle-check"></i><strong>@(Model.IsApproved ? "Đã duyệt" : "Chờ duyệt")</strong> Trạng thái</span>

                        @if (!string.IsNullOrEmpty(Model.TargetAudience) && Model.TargetAudience != "All")
                        {
                            <span><i class="fas fa-user-check text-info"></i><strong>@(Model.TargetAudience == "Student" ? "Sinh viên" : "Người đi làm")</strong> Ưu tiên</span>
                        }
                    </div>

                    <button type="button" class="room-map-button" id="roomMapToggle" aria-expanded="false" aria-controls="roomMapPanel">
                        <i class="fas fa-map-location-dot"></i>
                        <span><strong>Xem trên bản đồ</strong><small>Hiện vị trí phòng trọ ngay tại đây</small></span>
                        <i class="fas fa-chevron-down room-map-button__chevron"></i>
                    </button>

                    <div class="room-map-panel" id="roomMapPanel">
                        <iframe id="roomMapFrame" class="room-map-frame" src="@googleMapsEmbedUrl" title="Vị trí @Model.Title" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        <a id="roomMapExternal" href="@googleMapsLink" target="_blank" rel="noopener noreferrer" class="room-map-external">
                            <span id="roomMapExternalLabel">Mở vị trí chính xác bằng Google Maps</span> <i class="fas fa-arrow-up-right-from-square"></i>
                        </a>
                    </div>

                    <div class="room-action-grid">
                        <button type="button" class="room-action-card" id="roomDistanceToggle" aria-expanded="false" aria-controls="roomDistanceMenu">
                            <i class="fas fa-route"></i>
                            <span><strong>Xem khoảng cách</strong><small>Đến trường đại học của bạn</small></span>
                        </button>
                        <button type="button" class="room-action-card" id="roomNearbyToggle" aria-expanded="false" aria-controls="roomNearbyMenu">
                            <i class="fas fa-compass"></i>
                            <span><strong>Tiện ích xung quanh</strong><small>Quét theo bán kính</small></span>
                        </button>
                    </div>

                    <div class="room-distance-menu" id="roomDistanceMenu">
                        <label for="schoolMapInput">Nhập tên trường cần so sánh</label>
                        <div class="room-school-combobox">
                            <input type="text"
                                   id="schoolMapInput"
                                   role="combobox"
                                   aria-autocomplete="list"
                                   aria-expanded="false"
                                   aria-controls="schoolSearchResults"
                                   autocomplete="off"
                                   placeholder="Nhập từng ký tự tên trường, VD: H, HU..." />
                            <div id="schoolSearchResults" class="room-map-results room-school-combobox__results" role="listbox"></div>
                        </div>
                        <small class="room-nearby-hint"><i class="fas fa-keyboard"></i> Mỗi ký tự sẽ lọc toàn bộ trường và từng cơ sở trong khu vực @Model.City?.Name.</small>
                        <p id="schoolMapError" class="room-distance-menu__error" hidden>Vui lòng nhập tên trường.</p>
                        <div class="room-distance-menu__actions">
                            <button type="button" id="roomDistanceCancel">Hủy bỏ</button>
                            <button type="button" id="roomDistanceConfirm" class="is-primary">Tìm lại</button>
                        </div>
                    </div>

                    <div class="room-distance-menu" id="roomNearbyMenu">
                        <label class="fw-bold mb-2">Chọn tiện ích cần tìm quanh trọ</label>
                        <select id="nearbyCategoryInput" class="form-select mb-2">
                            <option value="supermarket">Chợ & Siêu thị</option>
                            <option value="hospital">Bệnh viện & Y tế</option>
                            <option value="bus_stop">Trạm xe buýt</option>
                            <option value="convenience_store">Cửa hàng tiện lợi 24/7</option>
                            <option value="restaurant_cafe">Ăn uống & Cafe</option>
                            <option value="gym">Phòng Gym & Thể thao</option>
                        </select>
                        <small class="room-nearby-hint"><i class="fas fa-wand-magic-sparkles"></i> Dữ liệu được tìm trực tiếp quanh tọa độ phòng trọ từ OpenStreetMap.</small>
                        <p id="nearbyMapError" class="room-distance-menu__error" hidden></p>
                        <div id="nearbySearchResults" class="room-map-results"></div>
                        <div class="room-distance-menu__actions">
                            <button type="button" id="roomNearbyCancel">Hủy bỏ</button>
                            <button type="button" id="roomNearbyConfirm" class="is-primary"><i class="fas fa-location-dot"></i> Tìm quanh đây</button>
                        </div>
                    </div>
                </section>

                @if (amenities.Any())
                {
                    <section class="room-detail-card">
                        <h2>Tiện ích đi kèm</h2>
                        <div class="room-amenities">
                            @foreach (var amenity in amenities)
                            {
                                <div class="room-amenity"><i class="fas @amenity.Item2"></i><span>@amenity.Item3</span></div>
                            }
                        </div>
                    </section>
                }

                <section class="room-detail-card">
                    <h2>Mô tả chi tiết</h2>
                    <p class="room-description">@Model.Description</p>
                </section>

                <section class="room-detail-card room-review-section" id="roomReviewSection">
                    <div class="room-review-section__heading">
                        <div>
                            <h2>Đánh giá từ người đã thuê</h2>
                            <p>Chỉ tài khoản đã được xác nhận thuê thành công mới có thể gửi đánh giá.</p>
                        </div>
                        <div class="room-review-score">
                            <strong>@(reviewCount > 0 ? averageRating.ToString("0.0") : "0.0")</strong>
                            <span>
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <i class="fas fa-star @(star <= Math.Round(averageRating) ? "is-active" : "")"></i>
                                }
                            </span>
                            <small>@reviewCount đánh giá</small>
                        </div>
                    </div>

                    @if (reviewableRentalRequestId.HasValue)
                    {
                        <form action="/Accommodation/SubmitReview" method="post" class="room-review-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="accommodationId" value="@Model.Id" />
                            <input type="hidden" name="rentalRequestId" value="@reviewableRentalRequestId.Value" />
                            <label>
                                <span>Chấm sao trải nghiệm</span>
                                <select name="rating" required>
                                    <option value="5">5 sao - Rất hài lòng</option>
                                    <option value="4">4 sao - Hài lòng</option>
                                    <option value="3">3 sao - Tạm ổn</option>
                                    <option value="2">2 sao - Chưa tốt</option>
                                    <option value="1">1 sao - Cần cải thiện nhiều</option>
                                </select>
                            </label>
                            <label>
                                <span>Chia sẻ ngắn cho người thuê sau</span>
                                <textarea name="comment" rows="3" maxlength="600" placeholder="Ví dụ: phòng đúng ảnh, chủ hỗ trợ tốt, khu vực yên tĩnh..."></textarea>
                            </label>
                            <button type="submit"><i class="fas fa-star"></i> Gửi đánh giá</button>
                        </form>
                    }
                    else if (User.IsInRole("User") && userIsRentingThisRoom)
                    {
                        <div class="room-review-note"><i class="fas fa-circle-check"></i> Bạn đã có quyền đánh giá sau khi thuê thành công. Nếu đã gửi rồi, hệ thống chỉ giữ một đánh giá cho mỗi lượt thuê.</div>
                    }

                    @if (roomReviews.Any())
                    {
                        <div class="room-review-list">
                            @foreach (var review in roomReviews.Take(8))
                            {
                                var reviewerName = review.Reviewer?.FullName ?? "Người thuê đã xác minh";
                                <article class="room-review-item">
                                    <div>
                                        <strong>@reviewerName</strong>
                                        <span>
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                <i class="fas fa-star @(star <= review.Rating ? "is-active" : "")"></i>
                                            }
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                                    {
                                        <p>@review.Comment</p>
                                    }
                                    <small>@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="room-review-empty">
                            <i class="far fa-star"></i>
                            <span>Phòng này chưa có đánh giá. Khi có lượt thuê thành công, người thuê sẽ nhận thông báo để đánh giá tại đây.</span>
                        </div>
                    }
                </section>
            </main>

            <aside class="room-detail-sidebar">
                <div class="room-detail-card room-contact-card">

                    @if (User.IsInRole("Admin") || (isAuthenticated && currentUserId != null && Model.OwnerId.ToString() == currentUserId))
                    {
                        <a href="@(User.IsInRole("Admin") ? $"/Admin/EditRoom/{Model.Id}" : $"/Accommodation/Edit/{Model.Id}")"
                           class="btn btn-warning w-100 fw-bold mb-4 py-2 shadow-sm d-flex justify-content-center align-items-center"
                           style="border-radius: 10px; font-size: 1.05rem; background-color: #ffc107; border-color: #ffc107; color: #000;">
                            <i class="fas fa-pen-to-square me-2"></i> Chỉnh sửa thông tin phòng
                        </a>
                        <hr class="mb-4 text-muted border-secondary opacity-25" />
                    }

                    <div class="mb-3 text-center border-bottom pb-3">
                        @if (Model.IsApproved)
                        {
                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fs-6 w-100">
                                <i class="fas fa-check-circle me-1"></i> Đã kiểm duyệt
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill fs-6 w-100">
                                <i class="fas fa-clock me-1"></i> Đang chờ duyệt
                            </span>
                        }
                    </div>

                    @{
                        bool isUnavailable = (Model.AccommodationType == "NhaNguyenCan" || Model.AccommodationType == "CanHo")
                                             ? Model.IsRented
                                             : (Model.AvailableRooms <= 0);
                    }

                    @if (Model.AccommodationType == "NhaNguyenCan" || Model.AccommodationType == "CanHo")
                    {
                        if (Model.IsRented)
                        {
                            <div class="alert alert-secondary mt-2 mb-4 py-2 text-center fw-bold"><i class="fas fa-lock me-1"></i> Đã cho thuê</div>
                        }
                        else
                        {
                            <div class="alert alert-success mt-2 mb-4 py-2 text-center fw-bold"><i class="fas fa-door-open me-1"></i> Đang cho thuê</div>
                        }
                    }
                    else
                    {
                        if (Model.AvailableRooms > 0)
                        {
                            <div class="alert alert-info mt-2 mb-4 py-2 text-center fw-bold"><i class="fas fa-bed me-1"></i> Còn trống @Model.AvailableRooms phòng</div>
                        }
                        else
                        {
                            <div class="alert alert-danger mt-2 mb-4 py-2 text-center fw-bold"><i class="fas fa-ban me-1"></i> Đã hết phòng</div>
                        }
                    }

                    <h2>Thông tin thuê phòng</h2>

                    @if (!userHasActiveRental)
                    {
                        <div class="room-occupant-section">
                            <label>Số lượng người ở</label>
                            <div class="room-occupant-control" data-max-occupants="@Model.MaxOccupants">
                                <button type="button" data-occupant-action="decrease" aria-label="Giảm số người"><i class="fas fa-minus"></i></button>
                                <strong id="roomOccupantCount">1</strong>
                                <button type="button" data-occupant-action="increase" aria-label="Tăng số người"><i class="fas fa-plus"></i></button>
                            </div>
                            <small>Phòng cho phép tối đa @Model.MaxOccupants người ở.</small>
                        </div>
                    }

                    @* ====== NÚT LIÊN HỆ NGAY ====== *@
                    @if (userHasActiveRental)
                    {
                        <div class="room-active-rental-note">
                            <i class="fas fa-house-circle-check"></i>
                            <div>
                                <strong>@(userIsRentingThisRoom ? "Bạn đang thuê phòng này" : "Bạn đang có một phòng thuê còn hiệu lực")</strong>
                                <span>@(userIsRentingThisRoom ? "Quản lý nơi ở trong mục Phòng đã thuê." : $"Phòng đang thuê: {activeRentalTitle}. Các phòng khác hiện chỉ để tham khảo.")</span>
                            </div>
                        </div>
                        <a href="/Rental/MyRentals" class="room-booking-button text-decoration-none"><i class="fas fa-key"></i> Mở phòng đã thuê</a>
                    }
                    else if (isUnavailable || Model.IsRentedOut)
                    {
                        var rentedText = Model.AccommodationType == "Nhà nguyên căn" ? "Đã có người thuê" : "Đã hết phòng";
                        <button type="button" class="room-booking-button is-disabled" style="background: #94a3b8; cursor: not-allowed;" disabled>
                            <i class="fas fa-ban"></i> @rentedText
                        </button>
                    }
                    else if (User.IsInRole("User"))
                    {
                        <button type="button" class="room-chat-button" onclick="openChatPopup(@Model.Id, 0)" id="btnContactNow">
                            <i class="fas fa-comments"></i> Liên hệ ngay
                        </button>
                    }
                    else if (isAuthenticated)
                    {
                        <button type="button" class="room-booking-button" disabled>Chỉ tài khoản người thuê mới có thể liên hệ</button>
                    }
                    else
                    {
                        <a href="/Auth/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)" class="room-chat-button">
                            <i class="fas fa-sign-in-alt"></i> Đăng nhập để liên hệ
                        </a>
                    }

                    <div class="room-owner">
                        @if (!string.IsNullOrWhiteSpace(Model.Owner?.AvatarUrl))
                        {
                            <img src="@Model.Owner.AvatarUrl" alt="Avatar của @ownerName" />
                        }
                        else
                        {
                            <div class="room-owner__fallback">@ownerInitial</div>
                        }
                        <div>
                            <strong>@ownerName</strong>
                            <span>Người cho thuê @(Model.Owner?.IsEmailConfirmed == true ? "· Đã xác thực" : "")</span>
                        </div>
                    </div>

                    <div class="room-contact-card__phone">
                        <i class="fas fa-phone"></i>
                        @if (isAuthenticated)
                        {
                            <span>@(string.IsNullOrWhiteSpace(Model.ContactPhone) ? "Chưa cập nhật số điện thoại" : Model.ContactPhone)</span>
                        }
                        else
                        {
                            <a href="/Auth/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)">Đăng nhập để xem số điện thoại</a>
                        }
                    </div>

                    @if (Model.IsApproved)
                    {
                        @if (isAuthenticated)
                        {
                            <button data-favorite-room-id="@Model.Id" data-favorite-label="true" onclick="toggleGlobalFavorite(@Model.Id, this)" class="room-favorite-button">
                                <i class="far fa-heart"></i><span>Lưu tin này</span>
                            </button>
                        }
                        else
                        {
                            <a href="/Auth/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path)" class="room-favorite-button text-decoration-none d-flex justify-content-center align-items-center">
                                <i class="far fa-heart me-2"></i> Đăng nhập để lưu tin
                            </a>
                        }
                    }
                    else
                    {
                        <div class="room-pending-note"><i class="fas fa-clock"></i> Bài đăng đang chờ Admin duyệt.</div>
                    }
                </div>

                <div class="room-safety-card">
                    <i class="fas fa-shield-halved"></i>
                    <div>
                        <strong>Giao dịch an toàn</strong>
                        <p>Hãy kiểm tra phòng thực tế và giấy tờ trước khi đặt cọc hoặc chuyển tiền.</p>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function goBackFromRoom() {
            if (window.history.length > 1) {
                window.history.back();
            } else {
                window.location.href = "/Accommodation/Search";
            }
        }

        document.querySelectorAll("[data-gallery-image]").forEach(button => {
            button.addEventListener("click", () => {
                const mainImage = document.getElementById("roomGalleryMainImage");
                const selectedImage = button.querySelector("img");
                if (!mainImage || !selectedImage) return;

                const oldMainSource = mainImage.src;
                mainImage.src = button.dataset.galleryImage;
                selectedImage.src = oldMainSource;
                button.dataset.galleryImage = oldMainSource;
            });
        });

        const mapToggle = document.getElementById("roomMapToggle");
        const mapPanel = document.getElementById("roomMapPanel");
        const mapFrame = document.getElementById("roomMapFrame");
        const mapExternal = document.getElementById("roomMapExternal");
        const mapExternalLabel = document.getElementById("roomMapExternalLabel");

        const roomMapExternalUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(googleMapsLink));

        const distanceToggle = document.getElementById("roomDistanceToggle");
        const distanceMenu = document.getElementById("roomDistanceMenu");
        const distanceCancel = document.getElementById("roomDistanceCancel");
        const distanceConfirm = document.getElementById("roomDistanceConfirm");
        const schoolInput = document.getElementById("schoolMapInput");
        const schoolError = document.getElementById("schoolMapError");
        const schoolSearchResults = document.getElementById("schoolSearchResults");
        let schoolSearchTimer = null;
        let schoolSearchController = null;
        let schoolSearchSequence = 0;

        const nearbyToggle = document.getElementById("roomNearbyToggle");
        const nearbyMenu = document.getElementById("roomNearbyMenu");
        const nearbyCancel = document.getElementById("roomNearbyCancel");
        const nearbyConfirm = document.getElementById("roomNearbyConfirm");
        const nearbyCategory = document.getElementById("nearbyCategoryInput");
        const nearbyMapError = document.getElementById("nearbyMapError");
        const nearbySearchResults = document.getElementById("nearbySearchResults");
        const roomLatitude = @(hasRoomCoordinates ? roomLatitude.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        const roomLongitude = @(hasRoomCoordinates ? roomLongitude.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        const roomCityName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.City?.Name ?? ""));

        function setMapOpen(isOpen) {
            mapPanel?.classList.toggle("is-open", isOpen);
            mapToggle?.classList.toggle("is-open", isOpen);
            mapToggle?.setAttribute("aria-expanded", isOpen.toString());
        }

        function setDistanceMenuOpen(isOpen) {
            distanceMenu?.classList.toggle("is-open", isOpen);
            distanceToggle?.setAttribute("aria-expanded", isOpen.toString());
            if (isOpen) schoolInput?.focus();
            if (!isOpen) {
                schoolSearchResults?.classList.remove("is-open");
                schoolInput?.setAttribute("aria-expanded", "false");
            }
        }

        function setNearbyMenuOpen(isOpen) {
            nearbyMenu?.classList.toggle("is-open", isOpen);
            nearbyToggle?.setAttribute("aria-expanded", isOpen.toString());
        }

        mapToggle?.addEventListener("click", () => {
            const willOpen = !mapPanel?.classList.contains("is-open");
            if (willOpen && mapFrame) {
                const roomMapEmbedUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(googleMapsEmbedUrl));
                mapFrame.src = roomMapEmbedUrl;
                mapExternal.href = roomMapExternalUrl;
                if (mapExternalLabel) mapExternalLabel.textContent = "Mở vị trí chính xác bằng Google Maps";
            }
            setMapOpen(willOpen);
        });

        distanceToggle?.addEventListener("click", () => {
            setNearbyMenuOpen(false);
            setDistanceMenuOpen(!distanceMenu?.classList.contains("is-open"));
        });

        nearbyToggle?.addEventListener("click", () => {
            setDistanceMenuOpen(false);
            setNearbyMenuOpen(!nearbyMenu?.classList.contains("is-open"));
        });

        distanceCancel?.addEventListener("click", () => {
            setDistanceMenuOpen(false);
            schoolError.hidden = true;
        });

        nearbyCancel?.addEventListener("click", () => {
            setNearbyMenuOpen(false);
            nearbyMapError.hidden = true;
        });

        function escapeMapText(value) {
            const element = document.createElement("div");
            element.textContent = value || "";
            return element.innerHTML;
        }

        function renderMapResults(container, results, emptyMessage) {
            if (!container) return;
            if (container === schoolSearchResults) {
                schoolInput?.setAttribute("aria-expanded", "true");
                container.classList.add("is-open");
            }
            if (!results?.length) {
                container.innerHTML = `<p class="room-map-results__empty">${escapeMapText(emptyMessage)}</p>`;
                return;
            }
            container.innerHTML = results.map(result => `
                <button type="button" class="room-map-result"
                        role="option"
                        data-map-latitude="${result.latitude}"
                        data-map-longitude="${result.longitude}"
                        data-map-name="${encodeURIComponent(result.name || "Điểm đến")}">
                    <span>
                        <strong>${escapeMapText(result.name)}</strong>
                        ${result.subtitle ? `<small>${escapeMapText(result.subtitle)}</small>` : ""}
                        ${result.distanceKm == null ? "" : `<small>Cách phòng khoảng ${Number(result.distanceKm).toLocaleString("vi-VN")} km</small>`}
                    </span>
                    <i class="fas fa-route"></i>
                </button>
            `).join("");
        }

        function showOsmRoute(destinationLatitude, destinationLongitude, destinationName) {
            if (roomLatitude == null || roomLongitude == null) {
                window.appAlert?.("Không đọc được tọa độ phòng trọ từ link Google Maps.");
                return;
            }
            const previewUrl = `/Map/PreviewRoute?originLat=${roomLatitude}&originLon=${roomLongitude}&destinationLat=${destinationLatitude}&destinationLon=${destinationLongitude}&destinationName=${encodeURIComponent(destinationName)}`;
            mapFrame.src = previewUrl;
            mapExternal.href = `https://www.google.com/maps/dir/?api=1&origin=${roomLatitude},${roomLongitude}&destination=${destinationLatitude},${destinationLongitude}&travelmode=driving`;
            if (mapExternalLabel) mapExternalLabel.textContent = "Mở đường đi chính xác bằng Google Maps";
            setMapOpen(true);
            setDistanceMenuOpen(false);
            setNearbyMenuOpen(false);
            mapPanel?.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }

        async function searchSchools() {
            const school = schoolInput?.value.trim();
            const searchSequence = ++schoolSearchSequence;
            if (!school) {
                schoolSearchController?.abort();
                schoolSearchResults.innerHTML = "";
                schoolSearchResults.classList.remove("is-open");
                schoolInput?.setAttribute("aria-expanded", "false");
                schoolError.hidden = true;
                return;
            }
            if (roomLatitude == null || roomLongitude == null) {
                schoolSearchResults.innerHTML = "";
                schoolSearchResults.classList.remove("is-open");
                schoolError.textContent = "Không đọc được tọa độ phòng trọ để xác định khu vực tìm trường.";
                schoolError.hidden = false;
                return;
            }

            schoolSearchController?.abort();
            schoolSearchController = new AbortController();
            distanceConfirm.disabled = true;
            schoolError.hidden = true;
            schoolSearchResults.classList.add("is-open");
            schoolSearchResults.innerHTML = '<p class="room-map-results__empty">Đang tìm trường...</p>';
            try {
                const searchParameters = new URLSearchParams({
                    query: school,
                    originLat: roomLatitude,
                    originLon: roomLongitude,
                    cityName: roomCityName
                });
                const response = await fetch(`/Map/SearchSchool?${searchParameters}`, {
                    signal: schoolSearchController.signal,
                    cache: "no-store"
                });
                const data = await response.json();
                if (searchSequence !== schoolSearchSequence) return;
                if (!response.ok || !data.success) throw new Error(data.message || "Không tìm được trường.");
                renderMapResults(schoolSearchResults, data.results || [], "Không tìm thấy trường hoặc cơ sở phù hợp trong khu vực này.");
            } catch (error) {
                if (error.name === "AbortError" || searchSequence !== schoolSearchSequence) return;
                schoolSearchResults.innerHTML = "";
                schoolSearchResults.classList.remove("is-open");
                schoolError.textContent = error.message || "Không thể tìm trường lúc này.";
                schoolError.hidden = false;
            } finally {
                if (searchSequence === schoolSearchSequence) distanceConfirm.disabled = false;
            }
        }

        distanceConfirm?.addEventListener("click", searchSchools);

        schoolInput?.addEventListener("input", () => {
            schoolError.hidden = true;
            window.clearTimeout(schoolSearchTimer);
            schoolSearchTimer = window.setTimeout(searchSchools, 400);
        });
        schoolInput?.addEventListener("keydown", event => {
            if (event.key === "Enter") {
                event.preventDefault();
                window.clearTimeout(schoolSearchTimer);
                searchSchools();
            }
            if (event.key === "Escape") {
                schoolSearchResults?.classList.remove("is-open");
                schoolInput.setAttribute("aria-expanded", "false");
            }
        });

        async function showAutomaticNearbySearch() {
            nearbyMapError.hidden = true;
            if (roomLatitude == null || roomLongitude == null) {
                nearbyMapError.textContent = "Không đọc được tọa độ phòng trọ từ link Google Maps.";
                nearbyMapError.hidden = false;
                return;
            }

            nearbyConfirm.disabled = true;
            nearbySearchResults.innerHTML = '<p class="room-map-results__empty">Đang tìm tiện ích...</p>';
            try {
                const response = await fetch(`/Map/Nearby?latitude=${roomLatitude}&longitude=${roomLongitude}&type=${encodeURIComponent(nearbyCategory.value)}&radius=2500`);
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || "Không tìm được tiện ích.");
                renderMapResults(nearbySearchResults, data.results, "Không tìm thấy tiện ích phù hợp trong bán kính 2,5 km.");
            } catch (error) {
                nearbySearchResults.innerHTML = "";
                nearbyMapError.textContent = error.message || "Không thể tìm tiện ích lúc này.";
                nearbyMapError.hidden = false;
            } finally {
                nearbyConfirm.disabled = false;
            }
        }

        nearbyCategory?.addEventListener("change", () => {
            showAutomaticNearbySearch();
        });

        nearbyConfirm?.addEventListener("click", showAutomaticNearbySearch);
        schoolSearchResults?.addEventListener("click", event => {
            const result = event.target.closest(".room-map-result");
            if (result) {
                const schoolName = decodeURIComponent(result.dataset.mapName);
                schoolInput.value = schoolName;
                schoolSearchResults.classList.remove("is-open");
                schoolInput.setAttribute("aria-expanded", "false");
                showOsmRoute(result.dataset.mapLatitude, result.dataset.mapLongitude, schoolName);
            }
        });
        document.addEventListener("click", event => {
            if (!event.target.closest(".room-school-combobox")) {
                schoolSearchResults?.classList.remove("is-open");
                schoolInput?.setAttribute("aria-expanded", "false");
            }
        });
        nearbySearchResults?.addEventListener("click", event => {
            const result = event.target.closest(".room-map-result");
            if (result) showOsmRoute(result.dataset.mapLatitude, result.dataset.mapLongitude, decodeURIComponent(result.dataset.mapName));
        });

        const occupantControl = document.querySelector("[data-max-occupants]");
        const occupantCount = document.getElementById("roomOccupantCount");
        const rentalRequestButton = document.getElementById("roomRentalRequestButton");
        const rentalRequestMessage = document.getElementById("roomRentalRequestMessage");
        let selectedOccupants = 1;
        if (occupantControl && occupantCount) {
            const maxOccupants = Number(occupantControl.dataset.maxOccupants) || 1;
            const decreaseButton = occupantControl.querySelector("[data-occupant-action='decrease']");
            const increaseButton = occupantControl.querySelector("[data-occupant-action='increase']");

            function updateOccupantControl() {
                occupantCount.textContent = selectedOccupants.toString();
                decreaseButton.disabled = selectedOccupants <= 1;
                increaseButton.disabled = selectedOccupants >= maxOccupants;
            }

            occupantControl.querySelectorAll("[data-occupant-action]").forEach(button => {
                button.addEventListener("click", () => {
                    const change = button.dataset.occupantAction === "increase" ? 1 : -1;
                    selectedOccupants = Math.min(maxOccupants, Math.max(1, selectedOccupants + change));
                    updateOccupantControl();
                });
            });

            updateOccupantControl();
        }

        rentalRequestButton?.addEventListener("click", async () => {
            rentalRequestButton.disabled = true;
            rentalRequestButton.textContent = "Đang gửi yêu cầu...";
            rentalRequestMessage.hidden = true;

            try {
                const response = await fetch("/Notification/RequestRent", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `accommodationId=${encodeURIComponent(rentalRequestButton.dataset.roomId)}&occupants=${selectedOccupants}`
                });
                const result = await response.json();
                rentalRequestMessage.textContent = result.message;
                rentalRequestMessage.classList.toggle("is-error", !response.ok);
                rentalRequestMessage.hidden = false;
                rentalRequestButton.textContent = response.ok ? "Đã gửi yêu cầu thuê" : "Đăng ký thuê ngay";
                rentalRequestButton.disabled = response.ok;
            } catch {
                rentalRequestMessage.textContent = "Không thể gửi yêu cầu lúc này. Vui lòng thử lại.";
                rentalRequestMessage.classList.add("is-error");
                rentalRequestMessage.hidden = false;
                rentalRequestButton.textContent = "Đăng ký thuê ngay";
                rentalRequestButton.disabled = false;
            }
        });
    </script>
}
