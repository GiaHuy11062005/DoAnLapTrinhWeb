@model IEnumerable<DoAnLapTrinhWeb.Models.Accommodation>

@{
    ViewData["Title"] = "Quản lý phòng trọ của tôi";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home/Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quản lý phòng</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="fw-bold text-dark"><i class="fas fa-tasks me-2"></i> @ViewData["Title"]</h2>
        <button class="btn btn-success btn-lg px-4 rounded-pill shadow" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
            <i class="fas fa-plus-circle me-2"></i> Đăng tin mới
        </button>
    </div>

    <div class="row mb-3 g-2">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Tìm theo tiêu đề hoặc địa chỉ...">
        </div>
        <div class="col-md-2">
            <select class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="approved">Đã duyệt</option>
                <option value="pending">Chờ duyệt</option>
            </select>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center" style="width: 50px;">STT</th>
                                <th style="width: 120px;">Ảnh</th>
                                <th>Tiêu đề bài đăng</th>
                                <th style="width: 250px;">Địa chỉ</th>
                                <th style="width: 150px;">Giá</th>
                                <th class="text-center" style="width: 130px;">Trạng thái</th>
                                <th class="text-center" style="width: 200px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">@stt</td>
                                    <td>
                                        @{
                                            var allImages = (item.Images != null && item.Images.Any())
                                                ? item.Images.Select(img => img.ImageUrl).ToList()
                                                : new List<string?> { "/images/accommodations/5007c941-3c42-4e59-8723-0e6c6a85373d_nhatro.jpg" };
                                            var firstImage = allImages.First();
                                            var imagesJson = System.Text.Json.JsonSerializer.Serialize(allImages);
                                        }
                                        <img src="@firstImage"
                                             class="img-thumbnail room-thumb-preview"
                                             alt="@item.Title"
                                             style="height: 80px; width: 110px; object-fit: cover; cursor: pointer;"
                                             onclick="openLightbox(@imagesJson, 0)"
                                             title="Click để xem tất cả ảnh">
                                        @if (allImages.Count > 1)
                                        {
                                            <span class="badge bg-dark position-relative" style="margin-left:-28px; vertical-align:super; font-size:0.7rem;">+@(allImages.Count - 1)</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Accommodation/Details/@item.Id" class="text-decoration-none fw-bold text-dark text-truncate d-inline-block" style="max-width: 300px;" title="@item.Title">
                                            @item.Title
                                        </a>
                                        <br>
                                        <small class="text-muted">Đăng ngày: @item.CreatedAt.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="text-muted small">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i> @item.SpecificAddress, @item.District?.Name, @item.City?.Name
                                    </td>
                                    <td class="text-danger fw-bold fs-6">
                                        @item.Price.ToString("N0") VNĐ
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsApproved)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i> Đã duyệt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="fas fa-clock me-1"></i> Chờ duyệt</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="/Accommodation/Details/@item.Id" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/Accommodation/Edit/@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa bài">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-danger" title="Xóa bài">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 mt-5">
            <div class="mb-4">
                <i class="fas fa-home fa-5x text-success opacity-50"></i>
            </div>
            <h3 class="fw-bold text-dark">Bạn chưa đăng tin cho thuê phòng nào</h3>
            <p class="text-muted fs-5 mt-3">Hãy bấm nút "Đăng tin mới" ở góc trên bên phải để bắt đầu tiếp cận hàng ngàn người thuê.</p>
            <button class="btn btn-success btn-lg px-5 mt-4 rounded-pill shadow" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
                <i class="fas fa-plus-circle me-2"></i> Đăng tin đầu tiên ngay!
            </button>
        </div>
    }
</div>

<!-- ============================================
     LIGHTBOX XEM ẢNH TOÀN MÀN HÌNH
     ============================================ -->
<div id="lightboxOverlay" style="
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.93);
    z-index: 99999;
">
    <!-- NÚT ĐÓNG (X) -->
    <button id="lbClose" title="Đóng (ESC)" onclick="closeLightbox()" style="
        position: absolute;
        top: 16px;
        right: 20px;
        background: rgba(255,255,255,0.12);
        border: none;
        color: #fff;
        font-size: 1.6rem;
        line-height: 1;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .2s;
        z-index: 100001;
    ">&#10005;</button>

    <!-- MŨI TÊN TRÁI -->
    <button id="lbPrev" title="Ảnh trước (←)" onclick="lbNavigate(-1)" style="
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        border: 2px solid rgba(255,255,255,0.3);
        color: #fff;
        font-size: 1.5rem;
        line-height: 1;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .2s, transform .2s;
        z-index: 100005;
    "><i class="fas fa-chevron-left"></i></button>

    <!-- MŨI TÊN PHẢI -->
    <button id="lbNext" title="Ảnh tiếp theo (→)" onclick="lbNavigate(1)" style="
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        border: 2px solid rgba(255,255,255,0.3);
        color: #fff;
        font-size: 1.5rem;
        line-height: 1;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .2s, transform .2s;
        z-index: 100005;
    "><i class="fas fa-chevron-right"></i></button>

    <!-- ẢNH CHÍNH (căn giữa) -->
    <div style="
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 90px;
        pointer-events: none;
    " onclick="event.stopPropagation()">
        <img id="lightboxImg" src="" alt="" style="
            max-width: 100%;
            max-height: 75vh;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 24px 80px rgba(0,0,0,0.7);
            transition: opacity 0.18s ease;
            pointer-events: auto;
        ">

        <!-- CHỈ SỐ ẢNH -->
        <div id="lightboxCounter" style="
            color: rgba(255,255,255,0.8);
            font-size: 0.9rem;
            font-weight: 600;
            margin-top: 14px;
            letter-spacing: 0.05em;
        "></div>

        <!-- THUMBNAILS -->
        <div id="lightboxThumbs" style="
            display: flex;
            gap: 8px;
            margin-top: 12px;
            overflow-x: auto;
            max-width: 80vw;
            padding-bottom: 4px;
            pointer-events: auto;
        "></div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover { background-color: rgba(25, 135, 84, 0.05); }
    .table td, .table th { vertical-align: middle; }
    .room-thumb-preview { transition: transform .2s, opacity .2s; cursor: zoom-in !important; }
    .room-thumb-preview:hover { transform: scale(1.06); opacity: 0.88; }
    #lbPrev:hover { background: rgba(255,255,255,0.3) !important; transform: translateY(-50%) scale(1.08) !important; }
    #lbNext:hover { background: rgba(255,255,255,0.3) !important; transform: translateY(-50%) scale(1.08) !important; }
    #lbClose:hover { background: rgba(239,68,68,0.6) !important; }
    #lightboxThumbs img { border-radius: 7px; cursor: pointer; transition: .18s; }
    #lightboxThumbs img:hover { transform: scale(1.05); }
</style>

<script>
    // --- LIGHTBOX XEM ẢNH ---
    var _lbImages = [];
    var _lbIndex = 0;

    // Mở lightbox với danh sách ảnh và chỉ số ảnh đầu tiên
    function openLightbox(images, startIndex) {
        if (!images || images.length === 0) return;
        
        _lbImages = images;
        _lbIndex = startIndex || 0;
        
        var overlay = document.getElementById('lightboxOverlay');
        overlay.style.display = 'block';
        document.body.style.overflow = 'hidden';

        // Ẩn mũi tên nếu chỉ có 1 ảnh
        var hasMult = _lbImages.length > 1;
        // Phải gán display là 'flex' vì CSS của button đang là flex
        document.getElementById('lbPrev').style.display = hasMult ? 'flex' : 'none';
        document.getElementById('lbNext').style.display = hasMult ? 'flex' : 'none';

        renderLightbox();
    }

    // Đóng lightbox
    function closeLightbox() {
        document.getElementById('lightboxOverlay').style.display = 'none';
        document.body.style.overflow = '';
    }

    // Di chuyển qua lại giữa các ảnh
    function lbNavigate(dir) {
        if (_lbImages.length <= 1) return;
        _lbIndex = (_lbIndex + dir + _lbImages.length) % _lbImages.length;
        renderLightbox();
    }

    // Render ảnh chính và thumbnails
    function renderLightbox() {
        const img = document.getElementById('lightboxImg');
        img.style.opacity = 0;
        
        setTimeout(() => {
            img.src = _lbImages[_lbIndex];
            img.style.opacity = 1;
        }, 120);

        document.getElementById('lightboxCounter').textContent = `Ảnh ${_lbIndex + 1} / ${_lbImages.length}`;

        // Render thumbnails
        const thumbsEl = document.getElementById('lightboxThumbs');
        thumbsEl.innerHTML = _lbImages.map((url, i) =>
            `<img src="${url}" onclick="_lbIndex=${i}; renderLightbox();"
             style="height:54px; width:72px; object-fit:cover; border-radius:8px; cursor:pointer; border: 2px solid ${i === _lbIndex ? '#fff' : 'transparent'}; opacity:${i === _lbIndex ? 1 : 0.55}; transition:.2s;">`
        ).join('');
    }

    // Click vào overlay để đóng
    document.getElementById('lightboxOverlay').addEventListener('click', function(e) {
        if (e.target === this) closeLightbox();
    });

    // Phím tắt: ESC để đóng, mũi tên trái/phải để điều hướng
    document.addEventListener('keydown', function(e) {
        if (document.getElementById('lightboxOverlay').style.display === 'block') {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') lbNavigate(-1);
            if (e.key === 'ArrowRight') lbNavigate(1);
        }
    });
</script>
