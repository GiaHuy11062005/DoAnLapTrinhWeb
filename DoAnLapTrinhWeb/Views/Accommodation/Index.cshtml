@model IEnumerable<DoAnLapTrinhWeb.Models.Accommodation>

@{
    ViewData["Title"] = "Quản lý phòng trọ của tôi";
}

<div class="container mt-4 mb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="fw-bold text-dark"><i class="fas fa-tasks me-2"></i> @ViewData["Title"]</h2>
        <button class="btn btn-success btn-lg px-4 rounded-pill shadow" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
            <i class="fas fa-plus-circle me-2"></i> Đăng tin mới
        </button>
    </div>

    <div class="row mb-3 g-2">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Tìm theo tiêu đề hoặc địa chỉ...">
        </div>
        <div class="col-md-2">
            <select class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="approved">Đã duyệt</option>
                <option value="pending">Chờ duyệt</option>
            </select>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center" style="width: 50px;">STT</th>
                                <th style="width: 120px;">Ảnh</th>
                                <th>Tiêu đề bài đăng</th>
                                <th style="width: 250px;">Địa chỉ</th>
                                <th style="width: 150px;">Giá</th>
                                <th class="text-center" style="width: 130px;">Trạng thái</th>
                                <th class="text-center" style="width: 200px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr id="landlord-room-@item.Id">
                                    <td class="text-center fw-bold">@stt</td>
                                    <td>
                                        @{
                                            var firstImage = (item.Images != null && item.Images.Any())
                                                ? item.Images.First().ImageUrl
                                                : "/images/default-room.jpg";
                                            var roomImages = item.Images?
                                                .Where(image => !string.IsNullOrWhiteSpace(image.ImageUrl))
                                                .Select(image => image.ImageUrl!)
                                                .ToList() ?? new List<string>();
                                        }
                                        <button type="button"
                                                class="landlord-gallery-trigger"
                                                data-room-title="@item.Title"
                                                data-room-images='@System.Text.Json.JsonSerializer.Serialize(roomImages)'>
                                            <img src="@firstImage" class="img-thumbnail" alt="@item.Title">
                                            @if (roomImages.Count > 1)
                                            {
                                                <span><i class="fas fa-images"></i> @roomImages.Count</span>
                                            }
                                        </button>
                                    </td>
                                    <td>
                                        <a href="/Accommodation/Details/@item.Id" class="text-decoration-none fw-bold text-dark text-truncate d-inline-block" style="max-width: 300px;" title="@item.Title">
                                            @item.Title
                                        </a>
                                        <br>
                                        <small class="text-muted">Đăng ngày: @item.CreatedAt.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="text-muted small">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i> @item.SpecificAddress, @item.District?.Name, @item.City?.Name
                                    </td>
                                    <td class="text-danger fw-bold fs-6">
                                        @item.Price.ToString("N0") VNĐ
                                    </td>
                                    <td class="text-center" data-room-status="@item.Id">
                                        @if (item.IsApproved)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i> Đã duyệt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="fas fa-clock me-1"></i> Chờ duyệt</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="/Accommodation/Details/@item.Id" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (item.IsApproved)
                                            {
                                                <a href="/Accommodation/Edit/@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa thông tin bài đã duyệt">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Chỉ sửa được sau khi Admin duyệt" disabled>
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger" title="Xóa bài">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 mt-5">
            <div class="mb-4">
                <i class="fas fa-home fa-5x text-success opacity-50"></i>
            </div>
            <h3 class="fw-bold text-dark">Bạn chưa đăng tin cho thuê phòng nào</h3>
            <p class="text-muted fs-5 mt-3">Hãy bấm nút "Đăng tin mới" ở góc trên bên phải để bắt đầu tiếp cận hàng ngàn người thuê.</p>
            <button class="btn btn-success btn-lg px-5 mt-4 rounded-pill shadow" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
                <i class="fas fa-plus-circle me-2"></i> Đăng tin đầu tiên ngay!
            </button>
        </div>
    }
</div>

<div class="landlord-gallery-modal" id="landlordGalleryModal" hidden>
    <div class="landlord-gallery-modal__backdrop" data-gallery-close></div>
    <div class="landlord-gallery-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="landlordGalleryTitle">
        <div class="landlord-gallery-modal__top">
            <div>
                <strong id="landlordGalleryTitle">Ảnh phòng trọ</strong>
                <span id="landlordGalleryCounter"></span>
            </div>
            <button type="button" data-gallery-close aria-label="Đóng"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="landlord-gallery-modal__stage">
            <button type="button" id="landlordGalleryPrevious" class="landlord-gallery-modal__arrow is-left" aria-label="Ảnh trước"><i class="fas fa-chevron-left"></i></button>
            <img id="landlordGalleryImage" src="" alt="Ảnh phòng trọ" />
            <button type="button" id="landlordGalleryNext" class="landlord-gallery-modal__arrow is-right" aria-label="Ảnh tiếp theo"><i class="fas fa-chevron-right"></i></button>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(25, 135, 84, 0.05); /* Màu xanh lá nhạt khi hover */
    }

    .table td, .table th {
        vertical-align: middle;
    }
</style>

@section Scripts {
    <script>
        const galleryModal = document.getElementById("landlordGalleryModal");
        const galleryImage = document.getElementById("landlordGalleryImage");
        const galleryTitle = document.getElementById("landlordGalleryTitle");
        const galleryCounter = document.getElementById("landlordGalleryCounter");
        const galleryPrevious = document.getElementById("landlordGalleryPrevious");
        const galleryNext = document.getElementById("landlordGalleryNext");
        let galleryImages = [];
        let galleryIndex = 0;

        function renderLandlordGallery() {
            if (!galleryImages.length) return;
            galleryImage.src = galleryImages[galleryIndex];
            galleryCounter.textContent = `${galleryIndex + 1} / ${galleryImages.length}`;
            const hasMultipleImages = galleryImages.length > 1;
            galleryPrevious.hidden = !hasMultipleImages;
            galleryNext.hidden = !hasMultipleImages;
        }

        function closeLandlordGallery() {
            galleryModal.hidden = true;
            document.body.classList.remove("gallery-modal-open");
        }

        document.querySelectorAll(".landlord-gallery-trigger").forEach(trigger => {
            trigger.addEventListener("click", () => {
                try {
                    galleryImages = JSON.parse(trigger.dataset.roomImages || "[]").filter(Boolean);
                } catch {
                    galleryImages = [];
                }
                if (!galleryImages.length) return;
                galleryIndex = 0;
                galleryTitle.textContent = trigger.dataset.roomTitle || "Ảnh phòng trọ";
                renderLandlordGallery();
                galleryModal.hidden = false;
                document.body.classList.add("gallery-modal-open");
            });
        });

        galleryPrevious?.addEventListener("click", () => {
            galleryIndex = (galleryIndex - 1 + galleryImages.length) % galleryImages.length;
            renderLandlordGallery();
        });
        galleryNext?.addEventListener("click", () => {
            galleryIndex = (galleryIndex + 1) % galleryImages.length;
            renderLandlordGallery();
        });
        document.querySelectorAll("[data-gallery-close]").forEach(button => button.addEventListener("click", closeLandlordGallery));
        document.addEventListener("keydown", event => {
            if (galleryModal?.hidden) return;
            if (event.key === "Escape") closeLandlordGallery();
            if (event.key === "ArrowLeft") galleryPrevious?.click();
            if (event.key === "ArrowRight") galleryNext?.click();
        });

        document.addEventListener("accommodationStatusChanged", event => {
            const update = event.detail;
            const row = document.getElementById(`landlord-room-${update.id}`);
            if (!row) return;

            if (update.status === "Rejected") {
                row.remove();
                return;
            }

            const statusCell = row.querySelector(`[data-room-status="${update.id}"]`);
            if (statusCell) {
                statusCell.innerHTML = '<span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i> Đã duyệt</span>';
            }
        });
    </script>
}
