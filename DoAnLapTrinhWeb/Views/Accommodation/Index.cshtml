@model IEnumerable<DoAnLapTrinhWeb.Models.Accommodation>
@{
    ViewData["Title"] = "Quản lý bài cho thuê";
    var rooms = Model?.ToList() ?? new();
    string currentTab = ViewBag.CurrentTab ?? "all";
    int totalCount = ViewBag.TotalPosts ?? rooms.Count;
    int approvedCount = ViewBag.ApprovedPosts ?? rooms.Count(item => item.IsApproved);
    int pendingCount = ViewBag.PendingPosts ?? rooms.Count(item => !item.IsApproved && !item.IsRejected);
    int rentedCount = ViewBag.RentedPosts ?? rooms.Count(item => item.IsRentedOut || item.IsRented);
}

<div class="listing-manage-page">
    <div class="listing-manage-shell">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-circle-check me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <header class="listing-manage-heading">
            <div>
                <span><i class="fas fa-building"></i> Không gian chủ trọ</span>
                <h1>Quản lý bài cho thuê</h1>
                <p>Theo dõi trạng thái duyệt, số phòng và cập nhật các bài đăng của bạn.</p>
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
                <i class="fas fa-plus"></i> Đăng tin mới
            </button>
        </header>

        <section class="listing-manage-summary">
            <div><span class="is-blue"><i class="fas fa-layer-group"></i></span><small>Tổng bài đăng</small><strong>@totalCount</strong></div>
            <div><span class="is-orange"><i class="fas fa-hourglass-half"></i></span><small>Đang chờ duyệt</small><strong>@pendingCount</strong></div>
            <div><span class="is-green"><i class="fas fa-circle-check"></i></span><small>Đã được duyệt</small><strong>@approvedCount</strong></div>
            <div><span class="is-dark"><i class="fas fa-key"></i></span><small>Đã cho thuê</small><strong>@rentedCount</strong></div>
        </section>

        <nav class="listing-manage-tabs" aria-label="Lọc bài đăng">
            <a class="@(currentTab == "all" ? "active" : "")" href="?tab=all">Tất cả bài đăng</a>
            <a class="@(currentTab == "choduyet" ? "active" : "")" href="?tab=choduyet">Chờ duyệt</a>
            <a class="@(currentTab == "conphong" ? "active" : "")" href="?tab=conphong">Đang trống</a>
            <a class="@(currentTab == "hetphong" ? "active" : "")" href="?tab=hetphong">Đã thuê / Hết phòng</a>
            <a class="@(currentTab == "phongtro" ? "active" : "")" href="?tab=phongtro">Phòng trọ</a>
            <a class="@(currentTab == "nhanguyencan" ? "active" : "")" href="?tab=nhanguyencan">Nhà nguyên căn</a>
        </nav>

        <section class="listing-manage-panel">
            <div class="listing-manage-panel__heading">
                <div><h2>@(currentTab == "choduyet" ? "Bài đăng đang chờ duyệt" : currentTab == "conphong" ? "Bài đăng đang còn trống" : currentTab == "hetphong" ? "Bài đã thuê hoặc hết phòng" : "Danh sách bài cho thuê")</h2><p>@rooms.Count bài đăng trong danh sách</p></div>
                <a href="/Landlord/Dashboard"><i class="fas fa-arrow-left"></i> Về dashboard</a>
            </div>

            <div class="listing-manage-list">
                @foreach (var item in rooms)
                {
                    var firstImage = item.Images?.FirstOrDefault()?.ImageUrl ?? "/images/default-room.jpg";
                    var roomImages = item.Images?
                        .Where(image => !string.IsNullOrWhiteSpace(image.ImageUrl))
                        .Select(image => image.ImageUrl!)
                        .ToList() ?? new List<string>();
                    var isPending = !item.IsApproved && !item.IsRejected;
                    var typeLabel = item.AccommodationType == "NhaNguyenCan" ? "Nhà nguyên căn" :
                        item.AccommodationType == "CanHo" ? "Căn hộ" :
                        item.AccommodationType == "SleepBox" ? "Ký túc xá / Sleepbox" : "Phòng trọ";

                    <article class="listing-manage-item @(isPending ? "is-pending" : "")" id="landlord-room-@item.Id">
                        <button type="button"
                                class="listing-manage-item__image landlord-gallery-trigger"
                                data-room-title="@item.Title"
                                data-room-images='@System.Text.Json.JsonSerializer.Serialize(roomImages)'>
                            <img src="@firstImage" alt="@item.Title" />
                            @if (roomImages.Count > 1) { <span><i class="fas fa-images"></i> @roomImages.Count ảnh</span> }
                        </button>

                        <div class="listing-manage-item__content">
                            <div class="listing-manage-item__top">
                                <div>
                                    <span class="listing-manage-item__type">@typeLabel</span>
                                    <a href="/Accommodation/Details/@item.Id">@item.Title</a>
                                </div>
                                <strong>@item.Price.ToString("N0")đ<small>/tháng</small></strong>
                            </div>
                            <p><i class="fas fa-location-dot"></i> @item.SpecificAddress, @item.District?.Name, @item.City?.Name</p>
                            <div class="listing-manage-item__meta" data-room-status="@item.Id">
                                <span><i class="far fa-calendar"></i> Đăng @item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                <span class="dashboard-status @(item.IsApproved ? "is-success" : item.IsRejected ? "is-danger" : "is-warning")">
                                    @(item.IsApproved ? "Đã duyệt" : item.IsRejected ? "Bị từ chối" : "Chờ duyệt")
                                </span>
                                <span class="dashboard-status @(item.IsRentedOut || item.IsRented ? "is-danger" : "is-info")">
                                    @(item.IsRentedOut || item.IsRented ? "Đã thuê / Hết phòng" : item.AccommodationType == "NhaNguyenCan" ? "Đang trống" : $"Còn {item.AvailableRooms} phòng")
                                </span>
                            </div>
                        </div>

                        <div class="listing-manage-item__actions">
                            <a href="/Accommodation/Details/@item.Id" class="btn btn-outline-primary"><i class="fas fa-eye"></i> Xem chi tiết</a>
                            @if (!isPending)
                            {
                                <a href="/Accommodation/Edit/@item.Id" class="btn btn-outline-secondary"><i class="fas fa-pen"></i> Chỉnh sửa</a>
                            }
                            <form action="/Accommodation/Delete" method="post" data-app-confirm="Bạn chắc chắn muốn xóa bài đăng này? Thao tác không thể hoàn tác.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-outline-danger"><i class="fas fa-trash"></i> Xóa bài</button>
                            </form>
                            @if (isPending) { <small><i class="fas fa-circle-info"></i> Bài chờ duyệt chưa thể chỉnh sửa.</small> }
                        </div>
                    </article>
                }

                @if (!rooms.Any())
                {
                    <div class="listing-manage-empty">
                        <span><i class="fas fa-house-circle-xmark"></i></span>
                        <h2>Chưa có bài đăng phù hợp</h2>
                        <p>Thử chọn bộ lọc khác hoặc đăng một tin cho thuê mới.</p>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#postAccommodationModal"><i class="fas fa-plus"></i> Đăng tin mới</button>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

<div class="landlord-gallery-modal" id="landlordGalleryModal" hidden>
    <div class="landlord-gallery-modal__backdrop" data-gallery-close></div>
    <div class="landlord-gallery-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="landlordGalleryTitle">
        <div class="landlord-gallery-modal__top">
            <div><strong id="landlordGalleryTitle">Ảnh phòng trọ</strong><span id="landlordGalleryCounter"></span></div>
            <button type="button" data-gallery-close aria-label="Đóng"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="landlord-gallery-modal__stage">
            <button type="button" id="landlordGalleryPrevious" class="landlord-gallery-modal__arrow is-left" aria-label="Ảnh trước"><i class="fas fa-chevron-left"></i></button>
            <img id="landlordGalleryImage" src="" alt="Ảnh phòng trọ" />
            <button type="button" id="landlordGalleryNext" class="landlord-gallery-modal__arrow is-right" aria-label="Ảnh tiếp theo"><i class="fas fa-chevron-right"></i></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const galleryModal = document.getElementById("landlordGalleryModal");
        const galleryImage = document.getElementById("landlordGalleryImage");
        const galleryTitle = document.getElementById("landlordGalleryTitle");
        const galleryCounter = document.getElementById("landlordGalleryCounter");
        const galleryPrevious = document.getElementById("landlordGalleryPrevious");
        const galleryNext = document.getElementById("landlordGalleryNext");
        let galleryImages = [];
        let galleryIndex = 0;

        function renderLandlordGallery() {
            if (!galleryImages.length) return;
            galleryImage.src = galleryImages[galleryIndex];
            galleryCounter.textContent = `${galleryIndex + 1} / ${galleryImages.length}`;
            galleryPrevious.hidden = galleryImages.length < 2;
            galleryNext.hidden = galleryImages.length < 2;
        }
        function closeLandlordGallery() {
            galleryModal.hidden = true;
            document.body.classList.remove("gallery-modal-open");
        }
        document.querySelectorAll(".landlord-gallery-trigger").forEach(trigger => {
            trigger.addEventListener("click", () => {
                try { galleryImages = JSON.parse(trigger.dataset.roomImages || "[]").filter(Boolean); }
                catch { galleryImages = []; }
                if (!galleryImages.length) return;
                galleryIndex = 0;
                galleryTitle.textContent = trigger.dataset.roomTitle || "Ảnh phòng trọ";
                renderLandlordGallery();
                galleryModal.hidden = false;
                document.body.classList.add("gallery-modal-open");
            });
        });
        galleryPrevious?.addEventListener("click", () => { galleryIndex = (galleryIndex - 1 + galleryImages.length) % galleryImages.length; renderLandlordGallery(); });
        galleryNext?.addEventListener("click", () => { galleryIndex = (galleryIndex + 1) % galleryImages.length; renderLandlordGallery(); });
        document.querySelectorAll("[data-gallery-close]").forEach(button => button.addEventListener("click", closeLandlordGallery));
        document.addEventListener("keydown", event => {
            if (galleryModal?.hidden) return;
            if (event.key === "Escape") closeLandlordGallery();
            if (event.key === "ArrowLeft") galleryPrevious?.click();
            if (event.key === "ArrowRight") galleryNext?.click();
        });
        document.addEventListener("accommodationStatusChanged", event => {
            const update = event.detail;
            const row = document.getElementById(`landlord-room-${update.id}`);
            if (!row) return;
            if (update.status === "Rejected") row.remove();
        });
    </script>
}
