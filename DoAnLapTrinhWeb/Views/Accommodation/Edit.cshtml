@model DoAnLapTrinhWeb.Models.Accommodation
@{
    ViewData["Title"] = "Chỉnh sửa bài đăng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="h3 fw-bold mb-0">Chỉnh sửa bài đăng</h2>
                        <a href="/Accommodation/Index" class="btn btn-outline-secondary rounded-pill">Quay lại</a>
                    </div>
                    
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form action="/Accommodation/Edit/@Model.Id" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Tiêu đề bài đăng <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-lg" value="@Model.Title" required>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Giá thuê (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" name="Price" class="form-control form-control-lg" value="@Model.Price" required min="100000">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Diện tích (m²) <span class="text-danger">*</span></label>
                                <input type="number" name="Area" class="form-control form-control-lg" value="@Model.Area" required min="1">
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Thành phố <span class="text-danger">*</span></label>
                                <select name="CityId" id="editCitySelect" class="form-select form-select-lg" required>
                                    <option value="">-- Chọn Thành phố --</option>
                                    @if (ViewBag.Cities != null)
                                    {
                                        foreach (var city in ViewBag.Cities)
                                        {
                                            <option value="@city.Id" selected="@(city.Id == Model.CityId ? "selected" : null)">@city.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Quận/Huyện <span class="text-danger">*</span></label>
                                <select name="DistrictId" id="editDistrictSelect" class="form-select form-select-lg" required>
                                    <option value="">-- Chọn Quận/Huyện --</option>
                                    @if (ViewBag.Districts != null)
                                    {
                                        foreach (var district in ViewBag.Districts)
                                        {
                                            <option value="@district.Id" selected="@(district.Id == Model.DistrictId ? "selected" : null)">@district.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Địa chỉ cụ thể <span class="text-danger">*</span></label>
                            <input type="text" name="SpecificAddress" class="form-control form-control-lg" value="@Model.SpecificAddress" required>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Mô tả chi tiết</label>
                            <textarea name="Description" class="form-control" rows="5">@Model.Description</textarea>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                <input type="text" name="ContactPhone" class="form-control form-control-lg" value="@Model.ContactPhone" required>
                            </div>
                            <div class="col-md-6 pt-md-4">
                                <div class="form-check form-check-inline mt-2">
                                    <input class="form-check-input" type="checkbox" id="editHasParking" name="HasParking" value="true" @(Model.HasParking ? "checked" : "")>
                                    <label class="form-check-label" for="editHasParking">Có chỗ để xe</label>
                                </div>
                                <div class="form-check form-check-inline mt-2">
                                    <input class="form-check-input" type="checkbox" id="editAllowsPets" name="AllowsPets" value="true" @(Model.AllowsPets ? "checked" : "")>
                                    <label class="form-check-label" for="editAllowsPets">Cho phép nuôi thú cưng</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Thêm ảnh mới (Ảnh cũ vẫn giữ nguyên)</label>
                            <input type="file" name="uploadImages" class="form-control form-control-lg" multiple accept="image/*">
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-info-circle me-2"></i><strong>Lưu ý:</strong> Sau khi cập nhật, bài đăng của bạn sẽ cần Admin duyệt lại trước khi được hiển thị.
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">Cập nhật và Gửi duyệt</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editCitySelect').addEventListener('change', function () {
            var cityId = this.value;
            var districtSelect = document.getElementById('editDistrictSelect');
            districtSelect.innerHTML = '<option value="">-- Đang tải --</option>';

            if (cityId) {
                fetch('/Accommodation/GetAllDistricts?cityId=' + cityId)
                    .then(response => response.json())
                    .then(data => {
                        districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                        data.forEach(function (district) {
                            var option = document.createElement('option');
                            option.value = district.id;
                            option.text = district.name;
                            districtSelect.add(option);
                        });
                    })
                    .catch(error => {
                        console.error('Error fetching districts:', error);
                        districtSelect.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
                    });
            } else {
                districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
            }
        });
    </script>
}
