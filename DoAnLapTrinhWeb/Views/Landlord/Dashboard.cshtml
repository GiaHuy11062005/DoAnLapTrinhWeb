@using DoAnLapTrinhWeb.Models
@{
    ViewData["Title"] = "Dashboard Chủ Trọ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var recentPosts = ViewBag.RecentPosts as List<Accommodation> ?? new();
    var recentRequests = ViewBag.RecentRequests as List<RentalRequest> ?? new();
    var notifications = ViewBag.RecentNotifications as List<AppNotification> ?? new();
    string timeFilter = ViewBag.CurrentTimeFilter ?? "all";
    string typeFilter = ViewBag.CurrentTypeFilter ?? "all";
    int totalPosts = ViewBag.TotalPosts ?? 0;
    int approvedPosts = ViewBag.ApprovedPosts ?? 0;
    int pendingPosts = ViewBag.PendingPosts ?? 0;
    int rejectedPosts = ViewBag.RejectedPosts ?? 0;
    int totalRequests = ViewBag.TotalRequests ?? 0;
    int pendingRequests = ViewBag.PendingRequests ?? 0;
    int negotiatingRequests = ViewBag.NegotiatingRequests ?? 0;
    int successRequests = ViewBag.SuccessRequests ?? 0;
    int cancelledRequests = ViewBag.CancelledRequests ?? 0;
    int availableRooms = ViewBag.TotalAvailableRooms ?? 0;
    int conversations = ViewBag.TotalConversations ?? 0;
    int unreadMessages = ViewBag.UnreadMessages ?? 0;
    int rentedOut = ViewBag.RentedOutPosts ?? 0;
    int unreadNotifications = ViewBag.UnreadNotifications ?? 0;
    var actionableRequests = recentRequests.Where(item => item.Status == "Pending" || item.Status == "Negotiating").Take(4).ToList();
}

<div class="dashboard-page">
    <div class="dashboard-shell">
        <header class="dashboard-heading">
            <div>
                <span class="dashboard-heading__label"><i class="fas fa-key"></i> Không gian chủ trọ</span>
                <h1>Tổng quan cho thuê</h1>
                <p>Theo dõi yêu cầu mới, phòng trống và công việc vận hành trong một màn hình gọn gàng.</p>
            </div>
            <div class="dashboard-heading__actions">
                <a href="/RentalProcess/Index" class="btn btn-outline-primary"><i class="fas fa-clipboard-check"></i> Xử lý cho thuê</a>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#postAccommodationModal"><i class="fas fa-plus"></i> Đăng tin mới</button>
            </div>
        </header>

        <form id="filterForm" method="get" action="/Landlord/Dashboard" class="dashboard-filter">
            <span><i class="fas fa-sliders"></i> Phạm vi dữ liệu</span>
            <select name="timeFilter" onchange="this.form.submit()">
                <option value="all" selected="@(timeFilter == "all")">Tất cả thời gian</option>
                <option value="today" selected="@(timeFilter == "today")">Hôm nay</option>
                <option value="7days" selected="@(timeFilter == "7days")">7 ngày qua</option>
                <option value="30days" selected="@(timeFilter == "30days")">30 ngày qua</option>
            </select>
            <select name="typeFilter" onchange="this.form.submit()">
                <option value="all" selected="@(typeFilter == "all")">Tất cả loại hình</option>
                <option value="PhongTro" selected="@(typeFilter == "PhongTro")">Phòng trọ</option>
                <option value="NhaNguyenCan" selected="@(typeFilter == "NhaNguyenCan")">Nhà nguyên căn</option>
                <option value="CanHo" selected="@(typeFilter == "CanHo")">Căn hộ</option>
                <option value="SleepBox" selected="@(typeFilter == "SleepBox")">Ký túc xá / Sleepbox</option>
            </select>
        </form>

        <section class="dashboard-metrics dashboard-metrics--landlord" aria-label="Số liệu tổng quan">
            <a href="/Accommodation/Index" class="dashboard-metric">
                <span class="dashboard-metric__icon is-blue"><i class="fas fa-building"></i></span>
                <span><small>Tổng bài đăng</small><strong>@totalPosts</strong><em>@approvedPosts đã duyệt · @pendingPosts chờ duyệt</em></span>
            </a>
            <a href="/RentalProcess/Index" class="dashboard-metric is-urgent">
                <span class="dashboard-metric__icon is-orange"><i class="fas fa-handshake"></i></span>
                <span><small>Đang xử lý cho thuê</small><strong>@(pendingRequests + negotiatingRequests)</strong><em>@pendingRequests chờ · @negotiatingRequests thương lượng</em></span>
            </a>
            <a href="/Chat/Inbox" class="dashboard-metric">
                <span class="dashboard-metric__icon is-dark"><i class="fas fa-comments"></i></span>
                <span><small>Tin nhắn</small><strong>@conversations</strong><em>@(unreadMessages > 0 ? $"{unreadMessages} chưa đọc" : "Tất cả đã đọc")</em></span>
            </a>
        </section>

        <div class="dashboard-priority-grid">
            <section class="dashboard-priority dashboard-priority--rental">
                <div class="dashboard-section-heading">
                    <div>
                        <span class="dashboard-section-heading__icon is-orange"><i class="fas fa-bolt"></i></span>
                        <div><h2>Đang xử lý cho thuê</h2><p>Yêu cầu mới nhất cần bạn phản hồi hoặc xác nhận.</p></div>
                    </div>
                    <a href="/RentalProcess/Index" class="dashboard-primary-link">Xem và xử lý ngay <i class="fas fa-arrow-right"></i></a>
                </div>
                <div class="dashboard-rental-list">
                    @foreach (var request in actionableRequests)
                    {
                        <a href="/RentalProcess/Index?status=@request.Status" class="dashboard-rental-item">
                            <span class="dashboard-rental-item__avatar">@(!string.IsNullOrEmpty(request.Renter?.FullName) ? request.Renter.FullName[..1].ToUpper() : "U")</span>
                            <span><strong>@request.Renter?.FullName</strong><small>@request.Accommodation?.Title</small><time>@request.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time></span>
                            <span class="dashboard-status @(request.Status == "Pending" ? "is-warning" : "is-info")">@(request.Status == "Pending" ? "Chờ phản hồi" : "Đang thương lượng")</span>
                        </a>
                    }
                    @if (!actionableRequests.Any())
                    {
                        <div class="dashboard-empty"><i class="fas fa-circle-check"></i><p>Không có yêu cầu nào đang chờ. Mọi việc đã được xử lý.</p></div>
                    }
                </div>
            </section>

            <section class="dashboard-latest">
                <div class="dashboard-section-heading">
                    <div>
                        <span class="dashboard-section-heading__icon is-blue"><i class="fas fa-bell"></i></span>
                        <div><h2>Thông báo mới nhất</h2><p id="dashboardUnreadNotificationCount">@(unreadNotifications == 0 ? "Tất cả thông báo đã đọc" : $"{unreadNotifications} thông báo chưa đọc")</p></div>
                    </div>
                    <button type="button" class="dashboard-icon-button" onclick="document.getElementById('notificationDropdownButton')?.click()" aria-label="Mở tất cả thông báo"><i class="fas fa-arrow-up-right-from-square"></i></button>
                </div>
                <div class="dashboard-notification-list">
                    @foreach (var item in notifications)
                    {
                        <a href="@(item.Url ?? "#")" data-notification-id="@item.Id" class="dashboard-notification @(!item.IsRead ? "is-unread" : "")">
                            <span><i class="fas @(item.Type == "RentalRequest" ? "fa-handshake" : item.Type == "Approval" ? "fa-circle-check" : item.Type == "Rejected" ? "fa-circle-xmark" : "fa-bell")"></i></span>
                            <span><strong>@item.Title</strong><small>@item.Message</small><time>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time></span>
                        </a>
                    }
                    @if (!notifications.Any()) { <div class="dashboard-empty"><i class="far fa-bell"></i><p>Chưa có thông báo mới.</p></div> }
                </div>
            </section>
        </div>

        <section class="dashboard-accordion">
            <button class="dashboard-accordion__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#landlordOperations" aria-expanded="false" aria-controls="landlordOperations">
                <span><i class="fas fa-table-cells-large"></i><span><strong>Quản lý & vận hành</strong><small>Các mục dashboard cũ được sắp xếp gọn tại đây</small></span></span>
                <i class="fas fa-chevron-down dashboard-accordion__chevron"></i>
            </button>
            <div class="collapse" id="landlordOperations">
                <div class="dashboard-operation-grid">
                    <a href="/RentalProcess/Index" class="is-highlight"><i class="fas fa-clipboard-check is-orange"></i><span><strong>Xử lý cho thuê</strong><small>@pendingRequests chờ · @negotiatingRequests thương lượng</small></span></a>
                    <a href="/Accommodation/Index"><i class="fas fa-building is-blue"></i><span><strong>Quản lý trọ</strong><small>@totalPosts bài đăng · @availableRooms phòng trống</small></span></a>
                    <a href="/Chat/Inbox"><i class="fas fa-comments is-blue"></i><span><strong>Tin nhắn</strong><small>@unreadMessages tin chưa đọc</small></span></a>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#postAccommodationModal"><i class="fas fa-plus-circle is-green"></i><span><strong>Đăng tin mới</strong><small>Tạo bài đăng cho thuê</small></span></button>
                    <a href="/Support/Create"><i class="fas fa-headset is-red"></i><span><strong>Liên hệ hỗ trợ</strong><small>Gửi yêu cầu đến Admin</small></span></a>
                    <a href="/"><i class="fas fa-house is-dark"></i><span><strong>Về trang chủ</strong><small>Xem giao diện công khai</small></span></a>
                </div>
            </div>
        </section>

        <section class="dashboard-detail-strip">
            <div><small>Bài đã duyệt</small><strong>@approvedPosts</strong></div>
            <div><small>Bài chờ duyệt</small><strong>@pendingPosts</strong></div>
            <div><small>Bài bị từ chối</small><strong>@rejectedPosts</strong></div>
            <div><small>Thuê thành công</small><strong>@successRequests</strong></div>
            <div><small>Yêu cầu đã hủy</small><strong>@cancelledRequests</strong></div>
        </section>

        <section class="dashboard-table-panel">
            <div class="dashboard-section-heading">
                <div><span class="dashboard-section-heading__icon is-blue"><i class="fas fa-clock-rotate-left"></i></span><div><h2>Bài đăng gần đây</h2><p>Theo dõi trạng thái các tin mới nhất của bạn</p></div></div>
                <a href="/Accommodation/Index">Quản lý tất cả <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table dashboard-table align-middle mb-0">
                    <thead><tr><th>Bài đăng</th><th>Giá thuê</th><th>Loại hình</th><th>Duyệt bài</th><th>Tình trạng</th></tr></thead>
                    <tbody>
                    @foreach (var post in recentPosts)
                    {
                        <tr>
                            <td><a href="/Accommodation/Details/@post.Id">@post.Title</a><small>@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td>
                            <td><strong>@post.Price.ToString("N0")đ</strong></td>
                            <td>@(post.AccommodationType == "NhaNguyenCan" ? "Nhà nguyên căn" : post.AccommodationType == "CanHo" ? "Căn hộ" : post.AccommodationType == "SleepBox" ? "Ký túc xá" : "Phòng trọ")</td>
                            <td><span class="dashboard-status @(post.IsApproved ? "is-success" : post.IsRejected ? "is-danger" : "is-warning")">@(post.IsApproved ? "Đã duyệt" : post.IsRejected ? "Từ chối" : "Chờ duyệt")</span></td>
                            <td>@(post.IsRentedOut || post.IsRented ? "Đã cho thuê" : post.AccommodationType == "NhaNguyenCan" ? "Đang trống" : $"Còn {post.AvailableRooms} phòng")</td>
                        </tr>
                    }
                    @if (!recentPosts.Any()) { <tr><td colspan="5"><div class="dashboard-empty">Bạn chưa có bài đăng nào.</div></td></tr> }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
