@{
    ViewData["Title"] = "Dashboard Chủ Trọ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var recentPosts = ViewBag.RecentPosts as List<DoAnLapTrinhWeb.Models.Accommodation> ?? new List<DoAnLapTrinhWeb.Models.Accommodation>();
    var recentRequests = ViewBag.RecentRequests as List<DoAnLapTrinhWeb.Models.RentalRequest> ?? new List<DoAnLapTrinhWeb.Models.RentalRequest>();
    string timeFilter = ViewBag.CurrentTimeFilter;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="fas fa-tachometer-alt text-primary me-2"></i> Dashboard Chủ Trọ</h2>
            <p class="text-muted mb-0">Theo dõi thống kê bài đăng, tình trạng phòng và yêu cầu thuê của bạn.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Accommodation/Index" class="btn btn-outline-primary rounded-pill"><i class="fas fa-list"></i> Quản lý trọ</a>
            <a href="/RentalProcess/Index" class="btn btn-outline-warning rounded-pill"><i class="fas fa-clipboard-check"></i> Xử lý thuê</a>
            <button class="btn btn-primary rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
                <i class="fas fa-plus"></i> Đăng tin mới
            </button>
        </div>
    </div>

    <!-- Bộ lọc -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body py-3">
            <form id="filterForm" method="get" action="/Landlord/Dashboard" class="row g-3 align-items-center">
                <div class="col-auto">
                    <span class="fw-bold me-2"><i class="fas fa-filter text-muted"></i> Lọc dữ liệu:</span>
                </div>
                <div class="col-md-3">
                    <select name="timeFilter" class="form-select rounded-pill" onchange="document.getElementById('filterForm').submit()">
                        <option value="all" selected="@(timeFilter == "all")">Tất cả thời gian</option>
                        <option value="today" selected="@(timeFilter == "today")">Hôm nay</option>
                        <option value="7days" selected="@(timeFilter == "7days")">7 ngày qua</option>
                        <option value="30days" selected="@(timeFilter == "30days")">30 ngày qua</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="typeFilter" class="form-select rounded-pill" onchange="document.getElementById('filterForm').submit()">
                        <option value="all" selected="@(ViewBag.CurrentTypeFilter == "all")">Tất cả loại bài đăng</option>
                        <option value="PhongTro" selected="@(ViewBag.CurrentTypeFilter == "PhongTro")">Phòng trọ</option>
                        <option value="NhaNguyenCan" selected="@(ViewBag.CurrentTypeFilter == "NhaNguyenCan")">Nhà nguyên căn</option>
                        <option value="CanHo" selected="@(ViewBag.CurrentTypeFilter == "CanHo")">Căn hộ</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Khối Thống Kê Bài Đăng -->
        <div class="col-md-6">
            <h5 class="fw-bold mb-3"><i class="fas fa-bullhorn text-warning me-2"></i> Thống Kê Bài Đăng</h5>
            <div class="row g-3">
                <div class="col-6">
                    <div class="card bg-primary text-white border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div><h6 class="opacity-75 mb-1 small">Tổng Bài Đăng</h6><h3 class="fw-bold mb-0">@ViewBag.TotalPosts</h3></div>
                            <i class="fas fa-layer-group fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-success text-white border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div><h6 class="opacity-75 mb-1 small">Đã Duyệt (Active)</h6><h3 class="fw-bold mb-0">@ViewBag.ApprovedPosts</h3></div>
                            <i class="fas fa-check-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-warning text-dark border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div><h6 class="opacity-75 mb-1 small">Đang Chờ Duyệt</h6><h3 class="fw-bold mb-0">@ViewBag.PendingPosts</h3></div>
                            <i class="fas fa-hourglass-half fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-danger text-white border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div><h6 class="opacity-75 mb-1 small">Bị Từ Chối</h6><h3 class="fw-bold mb-0">@ViewBag.RejectedPosts</h3></div>
                            <i class="fas fa-ban fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khối Yêu Cầu Thuê -->
        <div class="col-md-6">
            <h5 class="fw-bold mb-3"><i class="fas fa-handshake text-info me-2"></i> Yêu Cầu Thuê</h5>
            <div class="row g-3">
                <div class="col-6">
                    <div class="card bg-info text-white border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div><h6 class="opacity-75 mb-1 small">Tổng Yêu Cầu</h6><h3 class="fw-bold mb-0">@ViewBag.TotalRequests</h3></div>
                            <i class="fas fa-envelope-open-text fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100" style="background-color: #8e44ad; color: white;">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div><h6 class="opacity-75 mb-1 small">Đang Thương Lượng</h6><h3 class="fw-bold mb-0">@ViewBag.NegotiatingRequests</h3></div>
                            <i class="fas fa-comments-dollar fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-success text-white border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div><h6 class="opacity-75 mb-1 small">Thuê Thành Công</h6><h3 class="fw-bold mb-0">@ViewBag.SuccessRequests</h3></div>
                            <i class="fas fa-check-double fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-secondary text-white border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 d-flex justify-content-between align-items-center">
                            <div><h6 class="opacity-75 mb-1 small">Đã Hủy</h6><h3 class="fw-bold mb-0">@ViewBag.CancelledRequests</h3></div>
                            <i class="fas fa-times-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Khối Tình Trạng Phòng / Nhà -->
        <div class="col-12">
            <h5 class="fw-bold mb-3"><i class="fas fa-home text-success me-2"></i> Tình Trạng Hiện Tại</h5>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="card border border-success-subtle shadow-sm rounded-4">
                        <div class="card-body p-3 text-center">
                            <h6 class="text-muted fw-bold mb-1">Phòng Đang Trống</h6>
                            <h2 class="text-success fw-bold mb-0">@ViewBag.TotalAvailableRooms</h2>
                            <small class="text-muted">(Phòng trọ / Ký túc xá)</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border border-primary-subtle shadow-sm rounded-4">
                        <div class="card-body p-3 text-center">
                            <h6 class="text-muted fw-bold mb-1">Nhà Nguyên Căn (Trống)</h6>
                            <h2 class="text-primary fw-bold mb-0">@(ViewBag.TotalHouses - ViewBag.RentedHouses)</h2>
                            <small class="text-muted">Đang cho thuê</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border border-danger-subtle shadow-sm rounded-4">
                        <div class="card-body p-3 text-center">
                            <h6 class="text-muted fw-bold mb-1">Nhà Đã Cho Thuê</h6>
                            <h2 class="text-danger fw-bold mb-0">@ViewBag.RentedHouses</h2>
                            <small class="text-muted">Đã giao chìa khóa</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border border-warning-subtle shadow-sm rounded-4">
                        <div class="card-body p-3 text-center">
                            <h6 class="text-muted fw-bold mb-1">Bài Viết Đã Hết Phòng</h6>
                            <h2 class="text-warning fw-bold mb-0">@ViewBag.RentedOutPosts</h2>
                            <small class="text-muted">Tổng số tin đã đóng</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="fas fa-chart-bar text-primary me-2"></i> Lượt yêu cầu thuê (7 ngày qua)</h5>
                </div>
                <div class="card-body">
                    <canvas id="requestsChart" height="100"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="fas fa-chart-pie text-success me-2"></i> Tỷ lệ xử lý</h5>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="statusChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Bảng Yêu Cầu Thuê Gần Đây -->
        <div class="col-md-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom pt-4 pb-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="fas fa-bolt text-warning me-2"></i> Yêu cầu thuê mới nhất</h5>
                    <a href="/RentalProcess/Index" class="btn btn-sm btn-outline-primary rounded-pill">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Người liên hệ</th>
                                    <th>Bài đăng</th>
                                    <th>Thời gian</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-end pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var req in recentRequests)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 32px; height: 32px;">
                                                    @(!string.IsNullOrEmpty(req.Renter?.FullName) ? req.Renter.FullName.Substring(0,1).ToUpper() : "U")
                                                </div>
                                                <span class="fw-medium">@req.Renter?.FullName</span>
                                            </div>
                                        </td>
                                        <td><a href="/Accommodation/Details/@req.AccommodationId" target="_blank" class="text-dark text-decoration-none fw-medium text-truncate d-inline-block" style="max-width:250px;">@req.Accommodation?.Title</a></td>
                                        <td><span class="text-muted small">@req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></td>
                                        <td class="text-center">
                                            @if (req.Status == "Pending") { <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Đang chờ</span> }
                                            else if (req.Status == "Negotiating") { <span class="badge bg-info text-white px-3 py-2 rounded-pill">Thương lượng</span> }
                                            else if (req.Status == "Success") { <span class="badge bg-success px-3 py-2 rounded-pill">Thành công</span> }
                                            else { <span class="badge bg-secondary px-3 py-2 rounded-pill">Đã hủy</span> }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="/RentalProcess/Index" class="btn btn-sm btn-primary">Xử lý</a>
                                        </td>
                                    </tr>
                                }
                                @if(!recentRequests.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có yêu cầu thuê nào gần đây.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng Bài Đăng Gần Đây -->
        <div class="col-md-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom pt-4 pb-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="fas fa-list-alt text-primary me-2"></i> Bài đăng gần đây của bạn</h5>
                    <a href="/Accommodation/Index" class="btn btn-sm btn-outline-primary rounded-pill">Quản lý</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Tên bài đăng</th>
                                    <th>Giá thuê</th>
                                    <th>Loại hình</th>
                                    <th class="text-center">Trạng thái duyệt</th>
                                    <th class="text-end pe-4">Tình trạng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var post in recentPosts)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <a href="/Accommodation/Details/@post.Id" target="_blank" class="text-dark text-decoration-none fw-medium text-truncate d-inline-block" style="max-width:300px;">
                                                @post.Title
                                            </a>
                                            <br/><small class="text-muted">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                        </td>
                                        <td class="text-danger fw-bold">@post.Price.ToString("N0")đ</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @(post.AccommodationType == "NhaNguyenCan" ? "Nhà nguyên căn" : post.AccommodationType == "CanHo" ? "Căn hộ" : post.AccommodationType == "SleepBox" ? "Ký túc xá" : "Phòng trọ")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if(post.IsApproved) { <span class="badge bg-success-subtle text-success px-2 py-1"><i class="fas fa-check"></i> Đã duyệt</span> }
                                            else { <span class="badge bg-warning-subtle text-warning px-2 py-1"><i class="fas fa-clock"></i> Chờ duyệt</span> }
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (post.AccommodationType == "NhaNguyenCan")
                                            {
                                                if (post.IsRented) { <span class="text-danger fw-bold small">Đã cho thuê</span> }
                                                else { <span class="text-success fw-bold small">Đang trống</span> }
                                            }
                                            else
                                            {
                                                if (post.IsRentedOut) { <span class="text-danger fw-bold small">Đã hết phòng</span> }
                                                else { <span class="text-success fw-bold small">Còn @post.AvailableRooms phòng</span> }
                                            }
                                        </td>
                                    </tr>
                                }
                                @if(!recentPosts.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Bạn chưa có bài đăng nào.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Chart Yêu cầu theo ngày
            var datesRaw = '@Html.Raw(ViewBag.ChartRequestDates)';
            var countsRaw = '@Html.Raw(ViewBag.ChartRequestCounts)';
            
            var ctxLine = document.getElementById('requestsChart').getContext('2d');
            new Chart(ctxLine, {
                type: 'bar',
                data: {
                    labels: datesRaw ? datesRaw.split(',') : [],
                    datasets: [{
                        label: 'Số yêu cầu mới',
                        data: countsRaw ? countsRaw.split(',').map(Number) : [],
                        backgroundColor: 'rgba(13, 110, 253, 0.2)',
                        borderColor: 'rgba(13, 110, 253, 1)',
                        borderWidth: 2,
                        borderRadius: 4,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });

            // Chart Tỷ lệ trạng thái
            var ctxPie = document.getElementById('statusChart').getContext('2d');
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Đang chờ', 'Thương lượng', 'Thành công', 'Đã hủy'],
                    datasets: [{
                        data: [@ViewBag.PendingRequests, @ViewBag.NegotiatingRequests, @ViewBag.SuccessRequests, @ViewBag.CancelledRequests],
                        backgroundColor: ['#ffc107', '#0dcaf0', '#198754', '#6c757d'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // Lắng nghe SignalR để reload trang mượt mà nếu có yêu cầu thuê mới
            if (typeof window.connection !== 'undefined') {
                window.connection.on("MessageReceived", function() {
                    // Cập nhật lại UI hoặc reload
                    console.log("New rental request/message received. Need to update dashboard stats.");
                });
            }
        });
    </script>
}
