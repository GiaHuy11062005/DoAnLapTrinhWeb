@{
    ViewData["Title"] = "Hoàn thiện hồ sơ";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h4 class="mb-0 fw-bold"><i class="fab fa-google"></i> Chào Mừng Bạn!</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info text-center">
                        Chào <strong>@ViewBag.Name</strong>! Để hệ thống gợi ý phòng trọ phù hợp,
                        vui lòng cho chúng tôi biết thêm về bạn.
                    </div>

                    <form asp-action="CompleteProfile" method="post">
                        <input type="hidden" name="email" value="@ViewBag.Email" />
                        <input type="hidden" name="fullName" value="@ViewBag.Name" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email của bạn</label>
                            <input type="text" class="form-control" value="@ViewBag.Email" disabled />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-primary">
                                Bạn đang là? <span class="text-danger">*</span>
                            </label>
                            <select name="userIdentity" class="form-select border-primary" required>
                                <option value="" selected disabled>-- Chọn định danh --</option>
                                <option value="Student">Sinh viên</option>
                                <option value="Worker">Người đi làm</option>
                            </select>
                            <small class="text-muted mt-1 d-block">
                                <i class="fas fa-info-circle me-1"></i>
                                Hệ thống sẽ gợi ý phòng trọ gần Trường học / Nơi làm việc của bạn.
                                Bạn có thể thay đổi thông tin này trong trang Hồ sơ bất cứ lúc nào.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 fw-bold btn-lg rounded-pill">
                            Vào Trang Chủ <i class="fas fa-arrow-right ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>