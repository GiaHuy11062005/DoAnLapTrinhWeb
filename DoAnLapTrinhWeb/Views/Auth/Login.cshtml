@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">Đăng Nhập</h4>
                </div>
                <div class="card-body p-4">
                    
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mật khẩu</label>
                            <input type="password" name="password" class="form-control" required />
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <a href="#" class="text-decoration-none small text-primary">Quên mật khẩu?</a>
                            <a href="/Auth/Register" class="text-decoration-none small text-primary">Chưa có tài khoản? Đăng ký ngay</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold">Đăng Nhập</button>
                    </form>

                    <div class="mt-3 text-center">
                        <div class="position-relative d-flex align-items-center justify-content-center my-4">
                            <hr class="w-100 position-absolute" />
                            <span class="bg-white px-3 position-relative text-muted small fw-bold">HOẶC</span>
                        </div>
                        
                        <a asp-controller="Auth" asp-action="GoogleLogin" class="btn btn-outline-danger w-100 btn-lg rounded-pill fw-bold">
                            <i class="fab fa-google me-2"></i> Đăng nhập nhanh với Google
                        </a>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>