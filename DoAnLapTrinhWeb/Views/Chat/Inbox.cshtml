@model IEnumerable<ChatConversation>

@{
    ViewData["Title"] = "Tin nhắn";
    var currentUserId = (int)ViewBag.CurrentUserId;
    string timeFilter = ViewBag.TimeFilter ?? "all";
    string typeFilter = ViewBag.TypeFilter ?? "all";
    string statusFilter = ViewBag.StatusFilter ?? "all";
    string keyword = ViewBag.Keyword ?? "";
    bool isLandlord = User.IsInRole("Landlord");
}

<div class="container-fluid bg-light py-4 chat-inbox-page">
    <div class="row h-100 g-0 border rounded-4 shadow-sm bg-white overflow-hidden" style="min-height: 80vh; max-height: 85vh;">
        
        <!-- ========================================== -->
        <!-- CỘT TRÁI: DANH SÁCH CUỘC TRÒ CHUYỆN -->
        <!-- ========================================== -->
        <div class="col-md-5 col-lg-4 border-end d-flex flex-column h-100">
            <!-- Header & Bộ lọc -->
            <div class="p-3 border-bottom bg-white">
                <h4 class="fw-bold mb-3 text-primary"><i class="fas fa-comments me-2"></i>Tin nhắn</h4>
                <form id="filterForm" method="get" action="/Chat/Inbox">
                    <div class="input-group mb-2 shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" name="keyword" class="form-control border-start-0 ps-0" placeholder="Tìm tên, bài đăng, nội dung..." value="@keyword">
                    </div>
                    <div class="d-flex gap-2">
                        <select name="timeFilter" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                            <option value="all" selected="@(timeFilter == "all")">Mọi lúc</option>
                            <option value="today" selected="@(timeFilter == "today")">Hôm nay</option>
                            <option value="7days" selected="@(timeFilter == "7days")">7 ngày qua</option>
                            <option value="30days" selected="@(timeFilter == "30days")">30 ngày qua</option>
                        </select>
                        <select name="statusFilter" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                            <option value="all" selected="@(statusFilter == "all")">Tất cả TT</option>
                            <option value="unread" selected="@(statusFilter == "unread")">Chưa đọc</option>
                            <option value="negotiating" selected="@(statusFilter == "negotiating")">Chờ xác nhận</option>
                        </select>
                        <select name="typeFilter" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                            <option value="all" selected="@(typeFilter == "all")">Loại phòng</option>
                            <option value="PhongTro" selected="@(typeFilter == "PhongTro")">Phòng trọ</option>
                            <option value="NhaNguyenCan" selected="@(typeFilter == "NhaNguyenCan")">Nhà nguyên căn</option>
                            <option value="SleepBox" selected="@(typeFilter == "SleepBox")">Ký túc xá</option>
                        </select>
                    </div>
                    <button type="submit" class="d-none"></button>
                </form>
            </div>

            <!-- Danh sách -->
            <div class="chat-list overflow-y-auto flex-grow-1 bg-light">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-inbox fa-3x mb-3 opacity-50"></i>
                        <p>Không có cuộc trò chuyện nào.</p>
                        @if(!string.IsNullOrEmpty(keyword) || timeFilter != "all" || typeFilter != "all" || statusFilter != "all")
                        {
                            <a href="/Chat/Inbox" class="btn btn-sm btn-outline-primary mt-2">Xóa bộ lọc</a>
                        }
                    </div>
                }
                else
                {
                    @foreach (var conversation in Model)
                    {
                        var otherUser = isLandlord ? conversation.Renter : conversation.Landlord;
                        var otherName = otherUser?.FullName ?? (isLandlord ? "Người thuê" : "Chủ trọ");
                        
                        var lastMessage = conversation.Messages?.OrderByDescending(m => m.CreatedAt).FirstOrDefault();
                        var unreadCount = conversation.Messages?.Count(m => m.SenderId != currentUserId && !m.IsRead) ?? 0;
                        
                        var firstImage = conversation.Accommodation?.Images?.FirstOrDefault();
                        string accType = conversation.Accommodation?.AccommodationType == "NhaNguyenCan" ? "Nhà" : "Phòng";

                        <div class="chat-list-item p-3 border-bottom position-relative @(unreadCount > 0 ? "unread" : "")" 
                             data-conversation-id="@conversation.Id" 
                             onclick="loadChatContent(@conversation.Id, this)">
                            
                            <div class="d-flex align-items-center">
                                <!-- Cột 1: Thumbnail -->
                                <div class="position-relative me-3 flex-shrink-0">
                                    @if (firstImage != null)
                                    {
                                        <img src="@firstImage.ImageUrl" alt="Thumbnail" class="rounded-circle object-fit-cover shadow-sm" style="width: 54px; height: 54px;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 54px; height: 54px;">
                                            <i class="fas fa-home fs-5"></i>
                                        </div>
                                    }
                                    @if (unreadCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light">
                                            @unreadCount
                                        </span>
                                    }
                                </div>

                                <!-- Cột 2: Nội dung chính -->
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0 fw-bold text-truncate" style="max-width: 70%;">@otherName</h6>
                                        <small class="text-muted" style="font-size: 0.75rem;">
                                            @(lastMessage != null ? lastMessage.CreatedAt.ToString("dd/MM HH:mm") : "")
                                        </small>
                                    </div>
                                    <div class="text-truncate small text-primary fw-medium mb-1" style="max-width: 95%;">
                                        <i class="fas fa-map-marker-alt me-1"></i> @accType: @conversation.Accommodation?.Title
                                    </div>
                                    <div class="text-truncate small @(unreadCount > 0 ? "fw-bold text-dark" : "text-muted")">
                                        @if (lastMessage != null)
                                        {
                                            <span>@(lastMessage.SenderId == currentUserId ? "Bạn: " : "")@lastMessage.Content</span>
                                        }
                                        else
                                        {
                                            <span class="fst-italic">Chưa có tin nhắn</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Badges -->
                            @if (conversation.HasPendingNegotiation)
                            {
                                <div class="position-absolute bottom-0 end-0 p-2">
                                    <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">Chờ xác nhận</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ========================================== -->
        <!-- CỘT PHẢI: NỘI DUNG CHAT -->
        <!-- ========================================== -->
        <div class="col-md-7 col-lg-8 d-none d-md-flex flex-column h-100 bg-white" id="chatContentArea">
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                <div class="rounded-circle bg-light p-4 mb-3 d-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                    <i class="fas fa-paper-plane fa-3x text-primary opacity-50"></i>
                </div>
                <h5>Chọn một cuộc trò chuyện để bắt đầu</h5>
                <p>Nội dung tin nhắn sẽ hiển thị tại đây.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-inbox-page {
        height: calc(100vh - 150px);
    }
    .chat-list-item {
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .chat-list-item:hover {
        background-color: #f8f9fa;
    }
    .chat-list-item.active {
        background-color: #e9ecef;
        border-left: 4px solid var(--bs-primary) !important;
    }
    .chat-list-item.unread {
        background-color: #f0f8ff;
    }
    .chat-list::-webkit-scrollbar {
        width: 6px;
    }
    .chat-list::-webkit-scrollbar-thumb {
        background-color: rgba(0,0,0,0.1);
        border-radius: 10px;
    }
    
    /* Ghi đè CSS của _ChatHistory để nó vừa vặn cột phải thay vì là popup nổi */
    #chatContentArea .chat-popup-container {
        position: static !important;
        width: 100% !important;
        height: 100% !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        z-index: 1;
        bottom: auto;
        right: auto;
        display: flex;
        flex-direction: column;
    }
    #chatContentArea .chat-popup-header {
        border-radius: 0 !important;
        cursor: default !important;
    }
    #chatContentArea .fa-minus {
        display: none !important; /* Ẩn nút minimize khi ở chế độ cột */
    }
    #chatContentArea .chat-popup-body {
        flex-grow: 1;
        max-height: none !important;
        height: 100% !important;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Kiểm tra nếu có openChat từ URL
            const urlParams = new URLSearchParams(window.location.search);
            const openChatId = urlParams.get('openChat');
            if (openChatId) {
                const item = document.querySelector(`.chat-list-item[data-conversation-id="${openChatId}"]`);
                if (item) {
                    loadChatContent(openChatId, item);
                } else {
                    // Nếu không tìm thấy trong list (có thể do phân trang/filter), vẫn ép load
                    loadChatContent(openChatId, null);
                }
            }

            // Đè hàm openChatPopup global để không hiện popup Shopee khi đang ở trang Inbox
            window.openChatPopup = function(accommodationId, conversationId) {
                if (conversationId) {
                    const item = document.querySelector(`.chat-list-item[data-conversation-id="${conversationId}"]`);
                    loadChatContent(conversationId, item);
                } else if (accommodationId) {
                    // Fallback to create new
                    fetch('/Chat/StartPopup', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `accommodationId=${accommodationId}`
                    }).then(r => r.json()).then(data => {
                        if (data.success) {
                            window.location.href = '/Chat/Inbox?openChat=' + data.conversationId;
                        }
                    });
                }
            };
        });

        function loadChatContent(conversationId, element) {
            // Cập nhật UI Active
            document.querySelectorAll('.chat-list-item').forEach(el => el.classList.remove('active'));
            if (element) {
                element.classList.add('active');
                element.classList.remove('unread');
                // Ẩn badge nếu có
                const badge = element.querySelector('.badge.bg-danger');
                if (badge) badge.style.display = 'none';
            }

            const contentArea = document.getElementById('chatContentArea');
            contentArea.innerHTML = '<div class="d-flex justify-content-center align-items-center h-100"><div class="spinner-border text-primary" role="status"></div></div>';
            
            // Xóa d-none trên mobile
            contentArea.classList.remove('d-none');

            // Fetch nội dung
            fetch(`/Chat/GetChatHistory?conversationId=${conversationId}`)
                .then(res => {
                    if (res.ok) return res.text();
                    throw new Error("Lỗi tải tin nhắn");
                })
                .then(html => {
                    contentArea.innerHTML = html;
                    
                    // Thêm nút back cho mobile vào header
                    const header = contentArea.querySelector('.chat-popup-header h6');
                    if (header && window.innerWidth < 768) {
                        const backBtn = document.createElement('i');
                        backBtn.className = 'fas fa-arrow-left me-2 mt-1';
                        backBtn.style.cursor = 'pointer';
                        backBtn.onclick = function() {
                            contentArea.classList.add('d-none');
                        };
                        header.prepend(backBtn);
                    }

                    // Gán conversationId hiện tại cho global js (chat.js)
                    window.currentConversationId = parseInt(conversationId);

                    // Khởi tạo lại logic scroll
                    const msgs = document.getElementById("chatMessages");
                    if (msgs) {
                        msgs.scrollTop = msgs.scrollHeight;
                    }

                    // Tự xử lý nút Gửi trong 2-column layout (tránh xung đột với global popup)
                    setupInlineChatForm(conversationId);
                })
                .catch(err => {
                    contentArea.innerHTML = `<div class="p-4 text-center text-danger"><h5>Lỗi</h5><p>${err.message}</p></div>`;
                });
        }

        // Tự xử lý nút Gửi trong 2-column layout (tránh xung đột với global popup)
        function setupInlineChatForm(conversationId) {
            const sendBtn = document.getElementById('chatSendBtn');
            const input = document.getElementById('chatInput');
            
            if (!sendBtn || !input) return;

            // Xóa listener cũ bằng cách clone node
            const newSendBtn = sendBtn.cloneNode(true);
            sendBtn.parentNode.replaceChild(newSendBtn, sendBtn);

            const newInput = input.cloneNode(true);
            input.parentNode.replaceChild(newInput, input);

            newSendBtn.addEventListener('click', () => sendInlineMessage(conversationId, newInput, newSendBtn));
            newInput.addEventListener('keydown', (e) => {
                if (e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                    sendInlineMessage(conversationId, newInput, newSendBtn);
                }
            });
        }

        function sendInlineMessage(conversationId, input, sendBtn) {
            const content = input.value.trim();
            if (!content) return;

            input.disabled = true;
            sendBtn.disabled = true;

            fetch("/Chat/SendMessage", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `conversationId=${encodeURIComponent(conversationId)}&content=${encodeURIComponent(content)}`
            }).then(res => {
                if (res.ok) {
                    input.value = "";
                } else {
                    alert("Không thể gửi tin nhắn.");
                }
            }).catch(() => {
                alert("Lỗi kết nối.");
            }).finally(() => {
                input.disabled = false;
                sendBtn.disabled = false;
                input.focus();
            });
        }
    </script>
}
