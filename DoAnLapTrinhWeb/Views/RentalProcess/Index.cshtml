@model IEnumerable<DoAnLapTrinhWeb.Models.RentalRequest>
@{
    ViewData["Title"] = "Danh sách xử lý cho thuê";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container mt-4 mb-5 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-clipboard-list text-primary"></i> Danh sách xử lý cho thuê</h2>
    </div>

    <!-- Lọc trạng thái -->
    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "All" ? "active" : "")" href="/RentalProcess/Index?status=All">Tất cả</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Negotiating" ? "active" : "")" href="/RentalProcess/Index?status=Negotiating">Đang thương lượng</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Success" ? "active" : "")" href="/RentalProcess/Index?status=Success">Thành công</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Cancelled" ? "active" : "")" href="/RentalProcess/Index?status=Cancelled">Đã hủy</a>
        </li>
    </ul>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Người thuê</th>
                            <th>Bài đăng</th>
                            <th>Ngày xác nhận</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="fas fa-folder-open fa-2x mb-2"></i>
                                    <p>Không có yêu cầu nào.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.Renter?.AvatarUrl))
                                            {
                                                <img src="@item.Renter.AvatarUrl" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                            }
                                            <div>
                                                <strong>@item.Renter?.FullName</strong>
                                                <div class="small text-muted">@item.Renter?.Phone</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 250px;" title="@item.Accommodation?.Title">
                                            <a href="/Accommodation/Details/@item.AccommodationId" target="_blank" class="text-decoration-none fw-bold">@item.Accommodation?.Title</a>
                                        </div>
                                        <div class="small text-danger fw-semibold">
                                            @item.Accommodation?.Price.ToString("N0") đ/tháng
                                            <span class="text-muted ms-1">(@item.Accommodation?.AccommodationType)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <i class="far fa-calendar-alt text-muted"></i>
                                            @(item.ConfirmedAt?.ToString("dd/MM/yyyy HH:mm") ?? item.CreatedAt.ToString("dd/MM/yyyy"))
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Status == "Negotiating")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-sync fa-spin me-1"></i> Đang thương lượng</span>
                                        }
                                        else if (item.Status == "Success")
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Đã cho thuê</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i> Đã hủy</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.Status == "Negotiating")
                                        {
                                            <button type="button" class="btn btn-sm btn-success mb-1" onclick="markRentalSuccess(@item.Id)">
                                                <i class="fas fa-check"></i> Xác nhận cho thuê
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger mb-1" onclick="cancelRental(@item.Id)">
                                                <i class="fas fa-times"></i> Hủy
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-secondary disabled" disabled>Đã xử lý</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function markRentalSuccess(id) {
            if (!confirm("Xác nhận đã cho thuê thành công? Thao tác này sẽ tự động giảm số lượng phòng trống của bài đăng.")) return;
            try {
                const res = await fetch("/RentalProcess/Success", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `id=${id}`
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || "Lỗi khi cập nhật.");
                }
            } catch (e) {
                alert("Lỗi kết nối mạng.");
            }
        }

        async function cancelRental(id) {
            if (!confirm("Bạn muốn hủy yêu cầu thương lượng này?")) return;
            try {
                const res = await fetch("/RentalProcess/Cancel", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `id=${id}`
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || "Lỗi khi cập nhật.");
                }
            } catch (e) {
                alert("Lỗi kết nối mạng.");
            }
        }
    </script>
}
