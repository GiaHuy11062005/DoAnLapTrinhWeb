@model IEnumerable<DoAnLapTrinhWeb.Models.RentalRequest>
@{
    ViewData["Title"] = "Đang xử lý cho thuê";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentStatus = ViewBag.CurrentStatus ?? "All";
    var conversations = ViewBag.ConversationLookup as Dictionary<string, int> ?? new();
}

<div class="rental-process-page">
    <div class="rental-process-shell">
        <header class="rental-process-heading">
            <div>
                <span><i class="fas fa-handshake"></i> Quy trình cho thuê</span>
                <h1>Đang xử lý cho thuê</h1>
                <p>Tập trung xử lý yêu cầu mới, thương lượng và xác nhận bàn giao phòng.</p>
            </div>
            <a href="/Landlord/Dashboard" class="btn btn-outline-primary"><i class="fas fa-arrow-left"></i> Về dashboard</a>
        </header>

        <nav class="rental-status-tabs" aria-label="Lọc trạng thái yêu cầu thuê">
            <a class="@(currentStatus == "All" ? "active" : "")" href="/RentalProcess/Index?status=All">Tất cả</a>
            <a class="@(currentStatus == "Pending" ? "active" : "")" href="/RentalProcess/Index?status=Pending"><i class="fas fa-bell"></i> Chờ phản hồi</a>
            <a class="@(currentStatus == "Negotiating" ? "active" : "")" href="/RentalProcess/Index?status=Negotiating">Đang thương lượng</a>
            <a class="@(currentStatus == "Success" ? "active" : "")" href="/RentalProcess/Index?status=Success">Thành công</a>
            <a class="@(currentStatus == "Cancelled" ? "active" : "")" href="/RentalProcess/Index?status=Cancelled">Đã hủy</a>
            <a class="@(currentStatus == "Rejected" ? "active" : "")" href="/RentalProcess/Index?status=Rejected">Đã từ chối</a>
        </nav>

        <section class="rental-process-panel">
            <div class="rental-process-panel__heading">
                <div><h2>@(currentStatus == "All" ? "Tất cả yêu cầu" : currentStatus == "Pending" ? "Yêu cầu đang chờ phản hồi" : currentStatus == "Negotiating" ? "Yêu cầu đang thương lượng" : "Yêu cầu đã xử lý")</h2><p>@Model.Count() yêu cầu trong danh sách</p></div>
            </div>

            <div class="rental-process-list">
                @foreach (var item in Model)
                {
                    var conversationKey = $"{item.AccommodationId}:{item.RenterId}";
                    conversations.TryGetValue(conversationKey, out var conversationId);
                    <article class="rental-process-card @(item.Status == "Pending" ? "is-pending" : "")">
                        <div class="rental-process-card__person">
                            @if (!string.IsNullOrEmpty(item.Renter?.AvatarUrl))
                            {
                                <img src="@item.Renter.AvatarUrl" alt="@item.Renter.FullName" />
                            }
                            else
                            {
                                <span>@(!string.IsNullOrEmpty(item.Renter?.FullName) ? item.Renter.FullName[..1].ToUpper() : "U")</span>
                            }
                            <div><strong>@item.Renter?.FullName</strong><small>@item.Renter?.Phone</small></div>
                        </div>
                        <div class="rental-process-card__property">
                            <a href="/Accommodation/Details/@item.AccommodationId" target="_blank">@item.Accommodation?.Title</a>
                            <small>@item.Accommodation?.Price.ToString("N0")đ/tháng · @item.Occupants người ở</small>
                        </div>
                        <div class="rental-process-card__meta">
                            <small>Gửi lúc</small><strong>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                            <span class="dashboard-status @(item.Status == "Pending" ? "is-warning" : item.Status == "Negotiating" ? "is-info" : item.Status == "Success" ? "is-success" : "is-danger")">
                                @(item.Status == "Pending" ? "Chờ phản hồi" : item.Status == "Negotiating" ? "Đang thương lượng" : item.Status == "Success" ? "Đã cho thuê" : item.Status == "Rejected" ? "Đã từ chối" : "Đã hủy")
                            </span>
                        </div>
                        <div class="rental-process-card__actions">
                            @if (item.Status == "Pending")
                            {
                                <button type="button" class="btn btn-primary" onclick="beginNegotiation(@item.Id)"><i class="fas fa-handshake"></i> Bắt đầu thương lượng</button>
                                @if (conversationId > 0)
                                {
                                    <a href="/Chat/Inbox?openChat=@conversationId" class="btn btn-outline-primary"><i class="fas fa-comments"></i> Mở chat</a>
                                }
                                <button type="button" class="btn btn-outline-danger" onclick="rejectRental(@item.Id)">Từ chối</button>
                            }
                            else if (item.Status == "Negotiating")
                            {
                                <button type="button" class="btn btn-success" onclick="markRentalSuccess(@item.Id)"><i class="fas fa-check"></i> Xác nhận cho thuê</button>
                                <button type="button" class="btn btn-outline-danger" onclick="cancelRental(@item.Id)">Hủy</button>
                            }
                            else
                            {
                                <span class="rental-process-card__done"><i class="fas fa-circle-check"></i> Đã xử lý</span>
                            }
                        </div>
                    </article>
                }
                @if (!Model.Any())
                {
                    <div class="dashboard-empty rental-process-empty"><i class="fas fa-inbox"></i><h3>Không có yêu cầu nào</h3><p>Hãy thử chọn một trạng thái khác.</p></div>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        async function updateRental(url, id, confirmation) {
            if (!await window.appConfirm(confirmation)) return;
            try {
                const response = await fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `id=${id}`
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || "Không thể cập nhật yêu cầu.");
                location.reload();
            } catch (error) {
                window.appAlert?.(error.message || "Lỗi kết nối. Vui lòng thử lại.");
            }
        }
        function markRentalSuccess(id) {
            updateRental("/RentalProcess/Success", id, "Xác nhận đã cho thuê thành công? Số phòng trống sẽ được cập nhật tự động.");
        }
        async function beginNegotiation(id) {
            if (!await window.appConfirm("Bắt đầu thương lượng và mở chat với người thuê này?")) return;
            try {
                const response = await fetch("/RentalProcess/BeginNegotiation", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `id=${id}`
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || "Không thể bắt đầu thương lượng.");
                window.location.href = `/Chat/Inbox?openChat=${data.conversationId}`;
            } catch (error) {
                window.appAlert?.(error.message || "Lỗi kết nối. Vui lòng thử lại.");
            }
        }
        function rejectRental(id) {
            updateRental("/RentalProcess/Reject", id, "Từ chối yêu cầu thuê này?");
        }
        function cancelRental(id) {
            updateRental("/RentalProcess/Cancel", id, "Bạn muốn hủy yêu cầu đang thương lượng này?");
        }
    </script>
}
