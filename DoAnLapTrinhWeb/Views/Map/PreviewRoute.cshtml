@{
    Layout = null;
    var originLat = (double)ViewBag.OriginLat;
    var originLon = (double)ViewBag.OriginLon;
    var destinationLat = (double)ViewBag.DestinationLat;
    var destinationLon = (double)ViewBag.DestinationLon;
    var destinationName = (string)ViewBag.DestinationName;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        html, body, #map { width: 100%; height: 100%; margin: 0; }
        body { font-family: Arial, sans-serif; }
        .route-summary {
            position: absolute; z-index: 1000; top: 10px; left: 50%; transform: translateX(-50%);
            min-width: 190px; padding: 8px 12px; border-radius: 10px; background: rgba(255,255,255,.94);
            color: #344054; box-shadow: 0 5px 18px rgba(15,23,42,.16); font-size: 12px; text-align: center;
        }
        .route-summary strong { color: #1749a5; }
    </style>
</head>
<body>
    <div id="map"></div>
    <div id="routeSummary" class="route-summary">Đang tính tuyến đường...</div>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const origin = [@originLat.ToString(System.Globalization.CultureInfo.InvariantCulture), @originLon.ToString(System.Globalization.CultureInfo.InvariantCulture)];
        const destination = [@destinationLat.ToString(System.Globalization.CultureInfo.InvariantCulture), @destinationLon.ToString(System.Globalization.CultureInfo.InvariantCulture)];
        const destinationName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(destinationName));
        const map = L.map("map", { zoomControl: true });

        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);

        const destinationLabel = document.createElement("span");
        destinationLabel.textContent = destinationName;
        L.marker(origin).addTo(map).bindPopup("Vị trí phòng trọ");
        L.marker(destination).addTo(map).bindPopup(destinationLabel);
        map.fitBounds([origin, destination], { padding: [35, 35] });

        fetch(`/Map/Route?originLat=${origin[0]}&originLon=${origin[1]}&destinationLat=${destination[0]}&destinationLon=${destination[1]}`)
            .then(response => response.json().then(data => ({ ok: response.ok, data })))
            .then(({ ok, data }) => {
                if (!ok || !data.success) throw new Error(data.message || "Không thể tính tuyến đường.");
                const route = L.polyline(data.coordinates, { color: "#1749a5", weight: 5, opacity: .88 }).addTo(map);
                map.fitBounds(route.getBounds(), { padding: [35, 35] });
                document.getElementById("routeSummary").innerHTML =
                    `<strong>${data.distanceKm.toLocaleString("vi-VN")} km</strong> · khoảng ${data.durationMinutes} phút`;
            })
            .catch(error => {
                document.getElementById("routeSummary").textContent = error.message || "Không thể tính tuyến đường.";
            });
    </script>
</body>
</html>
