<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tiện Ích Trọ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")"
      data-user-id="@User.Claims.FirstOrDefault(claim => claim.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value"
      data-user-role="@User.Claims.FirstOrDefault(claim => claim.Type == System.Security.Claims.ClaimTypes.Role)?.Value">
    <header class="sticky-top app-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light navbar-glass py-2">
            <div class="container">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Chỗ Ở Tiện Ích
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars fs-3 text-dark"></i>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1 justify-content-center gap-4 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" href="/Admin">Bài đăng chờ duyệt</a>
                            </li>
                        }
                        else if (User.IsInRole("Landlord"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" href="/Accommodation/Index">Danh sách trọ đang cho thuê</a>
                            </li>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" href="/Home/SearchHistory">Lịch sử tìm phòng</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3 mt-3 mt-sm-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown app-notification">
                                <button class="app-notification__button" id="notificationDropdownButton" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Thông báo mới">
                                    <i class="far fa-bell"></i>
                                    <span id="notificationCount" class="app-notification__count" hidden>0</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end app-notification__menu">
                                    <div class="app-notification__heading">
                                        <div>
                                            <strong>@(User.IsInRole("Admin") ? "Thông báo quản trị" : User.IsInRole("Landlord") ? "Thông báo cho thuê" : "Thông báo thuê phòng")</strong>
                                            <span>Cập nhật realtime dành riêng cho tài khoản</span>
                                        </div>
                                        <button type="button" id="markNotificationsRead"><i class="fas fa-check"></i> Đã đọc</button>
                                    </div>
                                    <div id="notificationList" class="app-notification__list">
                                        <div class="app-notification__empty">Đang tải thông báo...</div>
                                    </div>
                                </div>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle rounded-pill fw-medium border-0 px-3 py-2 bg-light d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="/images/avatar-default.png" class="rounded-circle" width="28" height="28" alt="User" onerror="this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png'">
                                    @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-2">
                                    <li><a class="dropdown-item py-2" href="/Profile"><i class="fas fa-user-edit text-muted me-2"></i> Trang cá nhân</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item py-2" href="/Admin"><i class="fas fa-list-check text-muted me-2"></i> Danh sách duyệt bài</a></li>
                                    }
                                    @if (!User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item py-2" href="/Favorite/Index"><i class="fas fa-heart text-danger me-2"></i> Mục ưa thích</a></li>
                                    }
                                    <li><a class="dropdown-item py-2" href="/Home/SearchHistory"><i class="fas fa-clock-rotate-left text-muted me-2"></i> Lịch sử tìm phòng</a></li>
                                    @if (User.IsInRole("Landlord"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item py-2 text-danger" href="/Auth/Logout"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                            
                            @if (User.IsInRole("Landlord"))
                            {
                                <button class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
                                    <i class="fas fa-edit"></i> Đăng tin
                                </button>
                            }
                        }
                        else
                        {
                            <a href="/Auth/Login" class="text-dark text-decoration-none fw-medium me-2">Đăng nhập</a>
                            <a href="/Auth/Register" class="btn btn-primary">Đăng ký ngay</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <div class="modal fade listing-modal" id="postAccommodationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content listing-modal__content">
                <div class="modal-header listing-modal__header">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit"></i> Đăng tin cho thuê phòng</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                
                <form action="/Accommodation/Create" method="POST" enctype="multipart/form-data" id="postAccommodationForm">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">Tiêu đề bài đăng <span class="text-danger">*</span></label>
                                <input type="text" name="Title" class="form-control" required placeholder="VD: Phòng trọ khép kín, an ninh tốt...">
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Giá cho thuê (VNĐ/Tháng) <span class="text-danger">*</span></label>
                                <input type="number" name="Price" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Diện tích (m²) <span class="text-danger">*</span></label>
                                <input type="number" step="0.1" name="Area" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Giới hạn số người ở <span class="text-danger">*</span></label>
                                <select name="MaxOccupants" class="form-select" required>
                                    @for (var occupants = 1; occupants <= 20; occupants++)
                                    {
                                        <option value="@occupants">@occupants người</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select name="CityId" id="modalCitySelect" class="form-select" required>
                                    <option value="" selected disabled>-- Đang tải... --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Quận / Huyện <span class="text-danger">*</span></label>
                                <select name="DistrictId" id="modalDistrictSelect" class="form-select" required disabled>
                                    <option value="" selected disabled>-- Chọn Quận/Huyện --</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Số nhà, Tên đường cụ thể <span class="text-danger">*</span></label>
                                <input type="text" name="SpecificAddress" class="form-control" required placeholder="VD: 475A Điện Biên Phủ, Phường 25">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Link vị trí chính xác trên Google Maps <span class="text-danger">*</span></label>
                                <input type="url" name="GoogleMapsUrl" class="form-control" required placeholder="https://maps.app.goo.gl/...">
                                <small class="text-muted fst-italic">
                                    <i class="fas fa-location-dot"></i> Mở đúng vị trí trọ trên Google Maps, chọn Chia sẻ, rồi sao chép và dán liên kết vào đây.
                                </small>
                            </div>

                            <div class="col-12">
                                <div class="listing-amenities">
                                    <label class="form-label fw-bold d-block">Tiện ích đi kèm</label>
                                    <div class="listing-amenities__grid">
                                        <label><input type="checkbox" name="HasHighSpeedWifi" value="true"><i class="fas fa-wifi"></i> WiFi tốc độ cao</label>
                                        <label><input type="checkbox" name="HasInverterAirConditioner" value="true"><i class="fas fa-snowflake"></i> Máy lạnh Inverter</label>
                                        <label><input type="checkbox" name="HasWasherDryer" value="true"><i class="fas fa-soap"></i> Máy giặt sấy</label>
                                        <label><input type="checkbox" name="Has24HourSecurity" value="true"><i class="fas fa-shield-halved"></i> An ninh 24/7</label>
                                        <label><input type="checkbox" name="HasBasementParking" value="true"><i class="fas fa-square-parking"></i> Hầm để xe</label>
                                        <label><input type="checkbox" name="HasElevator" value="true"><i class="fas fa-elevator"></i> Thang máy</label>
                                        <label><input type="checkbox" name="HasRefrigerator" value="true"><i class="fas fa-temperature-low"></i> Tủ lạnh</label>
                                        <label><input type="checkbox" name="HasBalcony" value="true"><i class="fas fa-building"></i> Ban công</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold">Số điện thoại liên hệ (Của chủ phòng) <span class="text-danger">*</span></label>
                                <input type="text" name="ContactPhone" class="form-control" required value="@User.Claims.FirstOrDefault(c => c.Type == "Phone")?.Value">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Mô tả chi tiết <span class="text-danger">*</span></label>
                                <textarea name="Description" class="form-control" rows="4" required placeholder="Mô tả về điện, nước, giờ giấc sinh hoạt..."></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Hình ảnh phòng trọ (Tối đa 5 ảnh) <span class="text-danger">*</span></label>
                                <input type="file" id="accommodationImageInput" name="uploadImages" class="form-control" accept="image/*" multiple required>
                                <small class="text-muted">Chọn tối đa 5 ảnh. Ảnh sẽ được xem trước bên dưới.</small>
                                <div id="accommodationImagePreview" class="listing-image-preview"></div>
                            </div>

                            <div class="col-12">
                                <div class="listing-document-upload">
                                    <label class="form-label fw-bold">Hãy cập nhật giấy tờ đất bản sao có đóng mộc để kiểm tra <span class="text-danger">*</span></label>
                                    <p>Giấy tờ chỉ được Admin sử dụng để xác minh bài đăng và không hiển thị công khai.</p>
                                    <input type="file" id="landDocumentInput" name="landDocuments" class="form-control" accept="image/jpeg,image/png,application/pdf" multiple required>
                                    <small class="text-muted">Chọn tối đa 3 tệp JPG, PNG hoặc PDF; tối đa 10MB mỗi tệp.</small>
                                    <div id="landDocumentPreview" class="listing-image-preview listing-document-preview"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Gửi bài đăng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <footer class="app-footer">
        <div class="container app-footer__grid">
            <div class="app-footer__brand">
                <strong>Chỗ Ở Tiện Ích</strong>
                <p>&copy; 2026 Chỗ Ở Tiện Ích. Nền tảng tìm kiếm nhà ở đáng tin cậy cho sinh viên và người đi làm.</p>
            </div>
            <div>
                <strong>Khám phá</strong>
                <a href="/Accommodation/Search">Tìm phòng</a>
                <a href="/Home/Privacy">Hỗ trợ</a>
            </div>
            <div>
                <strong>Pháp lý</strong>
                <a href="/Home/Privacy">Chính sách bảo mật</a>
                <a href="/Home/Privacy">Điều khoản sử dụng</a>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/accommodation-realtime.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
