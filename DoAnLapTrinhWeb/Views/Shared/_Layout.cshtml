<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tiện Ích Trọ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var extraAmenities = new[]
        {
            new { Icon = "fa-wifi", Label = "Wifi tốc độ cao", Muted = false },
            new { Icon = "fa-snowflake", Label = "Điều hòa", Muted = false },
            new { Icon = "fa-fire-burner", Label = "Bếp nấu ăn", Muted = false },
            new { Icon = "fa-shield-halved", Label = "An ninh 24/7", Muted = false },
            new { Icon = "fa-sink", Label = "Khu vệ sinh riêng", Muted = false },
            new { Icon = "fa-shirt", Label = "Chỗ phơi đồ", Muted = false }
        };
    }

    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light navbar-glass py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3 text-dark d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                        <i class="fas fa-home fs-5"></i>
                    </div>
                    TiệnÍch<span style="color: var(--primary-color);">Trọ</span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars fs-3 text-dark"></i>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1 justify-content-center gap-3 fw-medium position-relative" id="mainNavbar">
                        <li class="nav-item">
                            <a class="nav-link text-dark hover-primary" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark hover-primary" asp-area="" asp-controller="Accommodation" asp-action="Search">Tìm phòng</a>
                        </li>
                        <!-- Dynamic Slider -->
                        <div id="navSlider" class="nav-slider"></div>
                    </ul>

                    <div class="d-flex align-items-center gap-3 mt-3 mt-sm-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Chuông thông báo -->
                            <div class="dropdown me-2 position-relative">
                                <button class="btn btn-light rounded-circle border-0" type="button" id="notificationDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" onclick="markNotificationsRead()">
                                    <i class="far fa-bell fs-5 text-dark" id="bellIcon"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notificationBadge">
                                        0
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-2" style="width: 320px; max-height: 400px; overflow-y: auto;" id="notificationList">
                                    <li><h6 class="dropdown-header">Thông báo của bạn</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><div class="text-center py-3 text-muted" id="noNotifMsg"><small>Đang tải...</small></div></li>
                                </ul>
                            </div>

                            <a href="/Favorite/Index" class="text-danger text-decoration-none fw-medium d-none d-md-block me-2" title="Yêu thích">
                                <i class="far fa-heart fs-5"></i>
                            </a>
                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle rounded-pill fw-medium border-0 px-3 py-2 bg-light d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="/images/avatar-default.png" class="rounded-circle" width="28" height="28" alt="User" onerror="this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png'">
                                    @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-2">
                                    <li><a class="dropdown-item py-2" href="/Profile/Update"><i class="fas fa-user-edit text-muted me-2"></i> Cập nhật hồ sơ</a></li>
                                    @if (!User.IsInRole("Landlord") && !User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item py-2" href="/Booking/StudentBookings"><i class="fas fa-list text-muted me-2"></i> Phòng đã đặt</a></li>
                                        <li><a class="dropdown-item py-2" href="/LandlordApplication/Create"><i class="fas fa-file-signature text-muted me-2"></i> Đăng ký làm chủ trọ</a></li>
                                    }
                                    @if (User.IsInRole("Landlord"))
                                    {
                                        <li><a class="dropdown-item py-2" href="/Accommodation/Index"><i class="fas fa-tasks text-muted me-2"></i> Quản lý phòng</a></li>
                                        <li><a class="dropdown-item py-2" href="/Booking/LandlordBookings"><i class="fas fa-calendar-check text-muted me-2"></i> Yêu cầu đặt phòng</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item py-2 text-danger" href="/Auth/Logout"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                            
                            @if (User.IsInRole("Landlord"))
                            {
                                <button class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
                                    <i class="fas fa-edit"></i> Đăng tin
                                </button>
                            }
                        }
                        else
                        {
                            <a href="/Auth/Login" class="text-dark text-decoration-none fw-medium me-2">Đăng nhập</a>
                            <a href="/Auth/Register" class="btn btn-primary">Đăng ký ngay</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <div class="modal fade" id="postAccommodationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit"></i> Đăng tin cho thuê phòng</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                
                <form action="/Accommodation/Create" method="POST" enctype="multipart/form-data">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">Tiêu đề bài đăng <span class="text-danger">*</span></label>
                                <input type="text" name="Title" class="form-control" required placeholder="VD: Phòng trọ khép kín, an ninh tốt...">
                            </div>
                            
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Giá cho thuê (VNĐ/Tháng) <span class="text-danger">*</span></label>
                                <input type="number" name="Price" class="form-control" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Diện tích (m²) <span class="text-danger">*</span></label>
                                <input type="number" step="0.1" name="Area" class="form-control" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Số người tối đa <span class="text-danger">*</span></label>
                                <input type="number" name="MaxPeople" class="form-control" required min="1" value="1">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select name="CityId" id="modalCitySelect" class="form-select" required>
                                    <option value="" selected disabled>-- Đang tải... --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Quận / Huyện <span class="text-danger">*</span></label>
                                <select name="DistrictId" id="modalDistrictSelect" class="form-select" required disabled>
                                    <option value="" selected disabled>-- Chọn Quận/Huyện --</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Số nhà, Tên đường cụ thể <span class="text-danger">*</span></label>
                                <input type="text" name="SpecificAddress" class="form-control" required placeholder="VD: 475A Điện Biên Phủ, Phường 25">
                                <small class="text-muted fst-italic"><i class="fas fa-info-circle"></i> Dùng để tích hợp định vị Google Maps.</small>
                            </div>

                            <div class="col-12 border rounded-4 p-3 bg-light">
                                <label class="form-label fw-bold d-block mb-3">Tiện ích đi kèm</label>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <div class="amenity-option">
                                            <input class="form-check-input" type="checkbox" id="AllowsPets" name="AllowsPets" value="true">
                                            <label class="amenity-option__label" for="AllowsPets">
                                                <i class="fas fa-paw"></i>
                                                <span>Cho nuôi chó/mèo</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="amenity-option">
                                            <input class="form-check-input" type="checkbox" id="HasParking" name="HasParking" value="true">
                                            <label class="amenity-option__label" for="HasParking">
                                                <i class="fas fa-motorcycle"></i>
                                                <span>Có bãi giữ xe</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <div class="amenity-option">
                                            <input class="form-check-input" type="checkbox" id="HasWifi" name="HasWifi" value="true">
                                            <label class="amenity-option__label" for="HasWifi">
                                                <i class="fas fa-wifi"></i>
                                                <span>Wifi tốc độ cao</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="amenity-option">
                                            <input class="form-check-input" type="checkbox" id="HasAirConditioner" name="HasAirConditioner" value="true">
                                            <label class="amenity-option__label" for="HasAirConditioner">
                                                <i class="fas fa-snowflake"></i>
                                                <span>Điều hòa</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="amenity-option">
                                            <input class="form-check-input" type="checkbox" id="HasKitchen" name="HasKitchen" value="true">
                                            <label class="amenity-option__label" for="HasKitchen">
                                                <i class="fas fa-fire-burner"></i>
                                                <span>Bếp nấu ăn</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="amenity-option">
                                            <input class="form-check-input" type="checkbox" id="HasSecurity" name="HasSecurity" value="true">
                                            <label class="amenity-option__label" for="HasSecurity">
                                                <i class="fas fa-shield-halved"></i>
                                                <span>An ninh 24/7</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="amenity-option">
                                            <input class="form-check-input" type="checkbox" id="HasPrivateBathroom" name="HasPrivateBathroom" value="true">
                                            <label class="amenity-option__label" for="HasPrivateBathroom">
                                                <i class="fas fa-sink"></i>
                                                <span>Khu vệ sinh riêng</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="amenity-option">
                                            <input class="form-check-input" type="checkbox" id="HasLaundryArea" name="HasLaundryArea" value="true">
                                            <label class="amenity-option__label" for="HasLaundryArea">
                                                <i class="fas fa-shirt"></i>
                                                <span>Chỗ phơi đồ</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold">Số điện thoại liên hệ (Của chủ phòng) <span class="text-danger">*</span></label>
                                <input type="text" name="ContactPhone" class="form-control" required value="@User.Claims.FirstOrDefault(c => c.Type == "Phone")?.Value">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Mô tả chi tiết <span class="text-danger">*</span></label>
                                <textarea name="Description" class="form-control" rows="4" required placeholder="Mô tả về điện, nước, giờ giấc sinh hoạt..."></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Hình ảnh phòng trọ (Tối đa 5 ảnh) <span class="text-danger">*</span></label>
                                <input type="file" name="uploadImages" class="form-control" accept="image/*" multiple required>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Gửi bài đăng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2026 - Hệ thống tìm kiếm chỗ ở tiện ích.</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // --- Logic Thông Báo (Notifications) ---
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <text>
            async function loadNotifications() {
                try {
                    // Lấy số lượng chưa đọc
                    const resCount = await fetch('/Notification/GetUnreadCount');
                    const dataCount = await resCount.json();
                    const badge = document.getElementById('notificationBadge');
                    if(dataCount.count > 0) {
                        badge.textContent = dataCount.count;
                        badge.classList.remove('d-none');
                    } else {
                        badge.classList.add('d-none');
                    }

                    // Lấy danh sách thông báo
                    const resList = await fetch('/Notification/GetNotifications');
                    const list = await resList.json();
                    const ul = document.getElementById('notificationList');
                    if(list.length > 0) {
                        let html = '<li><h6 class="dropdown-header d-flex justify-content-between align-items-center"><span>Thông báo</span> <a href="#" onclick="markAllRead(event)" class="text-decoration-none text-primary"><small>Đánh dấu đã đọc</small></a></h6></li><li><hr class="dropdown-divider"></li>';
                        list.forEach(n => {
                            let bgClass = n.isRead ? '' : 'bg-light';
                            html += `
                                <li>
                                    <form action="/Notification/MarkAsRead" method="post">
                                        <input type="hidden" name="id" value="${n.id}" />
                                        <button type="submit" class="dropdown-item py-2 border-bottom text-wrap ${bgClass}">
                                            <div class="d-flex w-100 justify-content-between">
                                              <strong class="mb-1 ${n.isRead ? 'text-muted' : ''}">${n.title}</strong>
                                              <small class="text-muted" style="font-size:0.7rem">${n.createdAt}</small>
                                            </div>
                                            <p class="mb-0 text-muted" style="font-size:0.85rem">${n.message}</p>
                                        </button>
                                    </form>
                                </li>
                            `;
                        });
                        ul.innerHTML = html;
                    } else {
                        document.getElementById('noNotifMsg').innerHTML = "<small>Bạn không có thông báo nào.</small>";
                    }
                } catch(e) { console.error(e); }
            }

            async function markAllRead(e) {
                e.preventDefault();
                await fetch('/Notification/MarkAllAsRead', { method: 'POST' });
                loadNotifications();
            }

            // Polling mỗi 30s
            loadNotifications();
            setInterval(loadNotifications, 30000);
            </text>
        }

        // --- Logic Dynamic Nav Slider ---
        document.addEventListener("DOMContentLoaded", function() {
            const navbar = document.getElementById('mainNavbar');
            const slider = document.getElementById('navSlider');
            if (!navbar || !slider) return;

            const links = navbar.querySelectorAll('.nav-link');
            let activeLink = null;

            // Tìm link hiện tại (active) dựa vào URL
            const currentUrl = window.location.pathname;
            links.forEach(link => {
                if (link.getAttribute('href') === currentUrl || 
                   (currentUrl === '/' && link.getAttribute('href') === '/Home/Index')) {
                    activeLink = link;
                    link.classList.add('fw-bold', 'text-primary'); // Highlight current
                }
            });

            // Hàm di chuyển slider
            function moveSlider(targetElement) {
                if (!targetElement) {
                    slider.style.opacity = 0;
                    return;
                }
                const rect = targetElement.getBoundingClientRect();
                const navRect = navbar.getBoundingClientRect();
                
                // Tính khoảng cách tương đối so với container (ul)
                const leftPos = rect.left - navRect.left;
                
                slider.style.width = `${rect.width}px`;
                slider.style.transform = `translateX(${leftPos}px)`;
                slider.style.opacity = 1;
            }

            // Khởi tạo vị trí ban đầu
            if (activeLink) {
                // Đợi layout render xong
                setTimeout(() => moveSlider(activeLink), 100);
            }

            // Xử lý sự kiện hover
            links.forEach(link => {
                link.addEventListener('mouseenter', function() {
                    moveSlider(this);
                });
            });

            // Khi chuột rời khỏi navbar, trả slider về vị trí active link ban đầu
            navbar.addEventListener('mouseleave', function() {
                moveSlider(activeLink);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <style>
        .amenity-option {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.9rem 1rem;
            border: 1px solid rgba(15, 23, 42, 0.1);
            border-radius: 18px;
            background: #fff;
            min-height: 58px;
        }

        .amenity-option__label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
            cursor: pointer;
            font-weight: 600;
            color: #0f172a;
            width: 100%;
        }

        .amenity-option__label i {
            color: var(--primary-color);
            width: 18px;
            text-align: center;
        }

        .amenity-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .amenity-tag {
            display: inline-flex;
            align-items: center;
            padding: 0.6rem 0.9rem;
            border-radius: 999px;
            background: rgba(37, 99, 235, 0.08);
            color: #1e3a8a;
            font-weight: 600;
            font-size: 0.92rem;
        }

        /* --- Dynamic Nav Slider --- */
        .nav-slider {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background-color: var(--primary-color, #2563eb);
            border-radius: 3px;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            width: 0;
            opacity: 0;
        }

        /* --- Dark Mode Customizations to match Admin Dashboard --- */
        [data-bs-theme="dark"] {
            --bs-body-bg: #111827; /* Tailwind bg-gray-900 */
            --bs-body-color: #f3f4f6; /* Tailwind text-gray-100 */
            --bs-secondary-bg: #1f2937; /* Tailwind bg-gray-800 */
        }
        
        [data-bs-theme="dark"] .bg-white,
        [data-bs-theme="dark"] .bg-light,
        [data-bs-theme="dark"] .card,
        [data-bs-theme="dark"] .modal-content,
        [data-bs-theme="dark"] .dropdown-menu {
            background-color: #1f2937 !important;
            border-color: #374151 !important;
            color: #f3f4f6 !important;
        }

        [data-bs-theme="dark"] .text-dark,
        [data-bs-theme="dark"] h1, [data-bs-theme="dark"] h2, 
        [data-bs-theme="dark"] h3, [data-bs-theme="dark"] h4, 
        [data-bs-theme="dark"] h5, [data-bs-theme="dark"] h6 {
            color: #f3f4f6 !important;
        }
        
        [data-bs-theme="dark"] .text-muted {
            color: #9ca3af !important;
        }

        [data-bs-theme="dark"] .navbar {
            background-color: rgba(31, 41, 55, 0.9) !important;
            border-bottom: 1px solid #374151;
        }

        [data-bs-theme="dark"] .btn-light {
            background-color: #374151 !important;
            color: #f3f4f6 !important;
            border-color: #4b5563 !important;
        }
        
        [data-bs-theme="dark"] .btn-light:hover {
            background-color: #4b5563 !important;
        }

        [data-bs-theme="dark"] .dropdown-item:hover {
            background-color: #374151 !important;
            color: #fff !important;
        }

        [data-bs-theme="dark"] .amenity-option {
            background-color: #1f2937 !important;
            border-color: #374151 !important;
        }

        [data-bs-theme="dark"] .amenity-option__label {
            color: #f3f4f6 !important;
        }
    </style>
</body>
</html>
