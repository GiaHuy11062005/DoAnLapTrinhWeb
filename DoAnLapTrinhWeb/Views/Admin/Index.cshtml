@model IEnumerable<DoAnLapTrinhWeb.Models.Accommodation>
@using DoAnLapTrinhWeb.Models
@{
    ViewData["Title"] = "Danh sách duyệt bài";
    var pendingRooms = Model?.ToList() ?? new List<Accommodation>();
    var approvalHistory = ViewBag.ApprovalHistory as List<ApprovalHistory> ?? new List<ApprovalHistory>();
}

<div class="admin-approval-page">
    <div class="admin-approval-shell">
        <div class="admin-approval-heading">
            <div>
                <span class="admin-approval-label"><i class="fas fa-shield-halved"></i> Khu vực quản trị</span>
                <h1>Danh sách bài đăng duyệt</h1>
                <p>Kiểm tra bài đăng mới và theo dõi toàn bộ lịch sử xử lý theo thời gian thực.</p>
            </div>
            <a href="/" class="btn btn-outline-primary">Về trang chủ</a>
        </div>

        <div class="admin-stat-grid">
            <div class="admin-stat-card"><i class="fas fa-clock"></i><div><strong id="pendingCount">@pendingRooms.Count</strong><span>Bài đang chờ duyệt</span></div></div>
            <div class="admin-stat-card"><i class="fas fa-circle-check"></i><div><strong id="approvedCount">@approvalHistory.Count(x => x.Action == "Approved" || x.Action == "ImportedApproved")</strong><span>Bài đã duyệt</span></div></div>
            <div class="admin-stat-card"><i class="fas fa-circle-xmark"></i><div><strong id="rejectedCount">@approvalHistory.Count(x => x.Action == "Rejected")</strong><span>Bài đã từ chối</span></div></div>
        </div>

        <ul class="nav nav-tabs admin-approval-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pendingApproval" type="button">Chờ duyệt <span id="pendingTabCount">@pendingRooms.Count</span></button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#approvalHistory" type="button">Lịch sử duyệt <span id="historyTabCount">@approvalHistory.Count</span></button></li>
        </ul>

        <div class="tab-content admin-approval-content">
            <div class="tab-pane fade show active" id="pendingApproval">
                <div class="table-responsive">
                    <table class="table align-middle admin-approval-table">
                        <thead><tr><th>Ngày gửi</th><th>Người cho thuê</th><th>Bài đăng</th><th>Giá thuê</th><th class="text-end">Xử lý</th></tr></thead>
                        <tbody id="pendingTableBody">
                            @foreach (var item in pendingRooms)
                            {
                                <tr id="pending-room-@item.Id">
                                    <td><span class="admin-table-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></td>
                                    <td><strong>@item.Owner?.FullName</strong><small>@item.Owner?.Email</small></td>
                                    <td><strong>@item.Title</strong><small>@item.District?.Name, @item.City?.Name</small></td>
                                    <td class="admin-table-price">@item.Price.ToString("N0") VNĐ</td>
                                    <td class="text-end">
                                        <a href="/Accommodation/Details/@item.Id" class="btn btn-sm btn-outline-primary" target="_blank">Xem trước</a>
                                        <a href="/Admin/Documents/@item.Id" class="btn btn-sm btn-outline-secondary" target="_blank">Giấy tờ</a>
                                        <form action="/Admin/Approve" method="post" class="d-inline approval-action-form" data-room-id="@item.Id" data-action="Approved"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-success">Duyệt</button></form>
                                        <form action="/Admin/Delete" method="post" class="d-inline approval-action-form" data-room-id="@item.Id" data-action="Rejected"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Từ chối</button></form>
                                    </td>
                                </tr>
                            }
                            @if (!pendingRooms.Any()) { <tr id="pendingEmptyRow"><td colspan="5" class="admin-empty-row">Hiện không có bài đăng nào đang chờ duyệt.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade" id="approvalHistory">
                <div class="table-responsive">
                    <table class="table align-middle admin-approval-table">
                        <thead><tr><th>Thời gian xử lý</th><th>Bài đăng</th><th>Người cho thuê</th><th>Người xử lý</th><th>Trạng thái</th></tr></thead>
                        <tbody id="approvalHistoryBody">
                            @foreach (var item in approvalHistory)
                            {
                                <tr id="history-@item.Id">
                                    <td><span class="admin-table-muted">@item.ProcessedAt.ToString("dd/MM/yyyy HH:mm")</span></td>
                                    <td><strong>@item.AccommodationTitle</strong><small>@item.Price.ToString("N0") VNĐ</small></td>
                                    <td><strong>@item.OwnerName</strong><small>@item.OwnerEmail</small></td>
                                    <td>@item.ProcessedBy</td>
                                    <td><span class="admin-status @(item.Action == "Rejected" ? "admin-status--rejected" : item.Action == "ImportedApproved" ? "admin-status--imported" : "admin-status--approved")">@(item.Action == "Rejected" ? "Đã từ chối" : item.Action == "ImportedApproved" ? "Đã duyệt trước đó" : "Đã duyệt")</span></td>
                                </tr>
                            }
                            @if (!approvalHistory.Any()) { <tr id="historyEmptyRow"><td colspan="5" class="admin-empty-row">Chưa có lịch sử xử lý bài đăng.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const pendingBody = document.getElementById("pendingTableBody");
    const historyBody = document.getElementById("approvalHistoryBody");
    const counts = {
        pending: document.getElementById("pendingCount"),
        pendingTab: document.getElementById("pendingTabCount"),
        historyTab: document.getElementById("historyTabCount"),
        approved: document.getElementById("approvedCount"),
        rejected: document.getElementById("rejectedCount")
    };
    const escapeHtml = value => { const el = document.createElement("div"); el.textContent = value ?? ""; return el.innerHTML; };
    const setPendingCount = value => {
        const count = Math.max(0, Number(value) || 0);
        counts.pending.textContent = counts.pendingTab.textContent = count;
        if (!count && !document.getElementById("pendingEmptyRow")) pendingBody.innerHTML = '<tr id="pendingEmptyRow"><td colspan="5" class="admin-empty-row">Hiện không có bài đăng nào đang chờ duyệt.</td></tr>';
    };
    const removePending = id => {
        const row = document.getElementById(`pending-room-${id}`);
        if (!row) return;
        row.remove();
        setPendingCount(Number(counts.pending.textContent) - 1);
    };
    const addHistory = item => {
        if (!item.historyId || document.getElementById(`history-${item.historyId}`)) return;
        document.getElementById("historyEmptyRow")?.remove();
        const rejected = item.status === "Rejected";
        const row = document.createElement("tr");
        row.id = `history-${item.historyId}`;
        row.innerHTML = `<td><span class="admin-table-muted">${escapeHtml(item.processedAt)}</span></td><td><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.price)} VNĐ</small></td><td><strong>${escapeHtml(item.ownerName)}</strong><small>${escapeHtml(item.ownerEmail)}</small></td><td>${escapeHtml(item.processedBy)}</td><td><span class="admin-status ${rejected ? "admin-status--rejected" : "admin-status--approved"}">${rejected ? "Đã từ chối" : "Đã duyệt"}</span></td>`;
        historyBody.prepend(row);
        counts.historyTab.textContent = Number(counts.historyTab.textContent) + 1;
        const statusCount = rejected ? counts.rejected : counts.approved;
        statusCount.textContent = Number(statusCount.textContent) + 1;
    };
    const bindForm = form => form.addEventListener("submit", async event => {
        event.preventDefault();
        if (form.dataset.action === "Rejected" && !confirm("Bạn có chắc chắn muốn từ chối bài đăng này không?")) return;
        const response = await fetch(form.action, { method: "POST", headers: { "X-Requested-With": "XMLHttpRequest" }, body: new FormData(form) });
        if (response.ok) removePending(form.dataset.roomId);
    });
    document.querySelectorAll(".approval-action-form").forEach(bindForm);
    document.addEventListener("pendingAccommodationProcessed", event => { removePending(event.detail.id); addHistory(event.detail); });
    document.addEventListener("pendingAccommodationCreated", async event => {
        if (document.getElementById(`pending-room-${event.detail.id}`)) return;
        const response = await fetch(`/Admin/PendingRoom?id=${event.detail.id}`);
        if (!response.ok) return;
        const room = await response.json();
        document.getElementById("pendingEmptyRow")?.remove();
        const row = document.createElement("tr");
        row.id = `pending-room-${room.id}`;
        row.innerHTML = `<td><span class="admin-table-muted">${escapeHtml(room.createdAt)}</span></td><td><strong>${escapeHtml(room.ownerName)}</strong><small>${escapeHtml(room.ownerEmail)}</small></td><td><strong>${escapeHtml(room.title)}</strong><small>${escapeHtml(room.location)}</small></td><td class="admin-table-price">${escapeHtml(room.price)} VNĐ</td><td class="text-end"><a href="/Accommodation/Details/${room.id}" class="btn btn-sm btn-outline-primary" target="_blank">Xem trước</a> <a href="/Admin/Documents/${room.id}" class="btn btn-sm btn-outline-secondary" target="_blank">Giấy tờ</a> <form action="/Admin/Approve" method="post" class="d-inline approval-action-form" data-room-id="${room.id}" data-action="Approved"><input type="hidden" name="id" value="${room.id}"><button class="btn btn-sm btn-success">Duyệt</button></form> <form action="/Admin/Delete" method="post" class="d-inline approval-action-form" data-room-id="${room.id}" data-action="Rejected"><input type="hidden" name="id" value="${room.id}"><button class="btn btn-sm btn-outline-danger">Từ chối</button></form></td>`;
        pendingBody.prepend(row);
        row.querySelectorAll(".approval-action-form").forEach(bindForm);
        setPendingCount(Number(counts.pending.textContent) + 1);
    });
</script>
}
