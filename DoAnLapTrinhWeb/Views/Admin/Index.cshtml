@using DoAnLapTrinhWeb.Models
@{
    ViewData["Title"] = "Dashboard Quản Trị";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var recentActivities = ViewBag.RecentActivities as List<Accommodation> ?? new();
    var notifications = ViewBag.RecentNotifications as List<AppNotification> ?? new();
    int totalUsers = ViewBag.TotalUsers ?? 0;
    int totalLandlords = ViewBag.TotalLandlords ?? 0;
    int totalTenants = ViewBag.TotalTenants ?? 0;
    int approvedRooms = ViewBag.ApprovedRooms ?? 0;
    int pendingRooms = ViewBag.PendingRoomsCount ?? 0;
    int rejectedRooms = ViewBag.RejectedRooms ?? 0;
    int totalRooms = ViewBag.TotalRooms ?? 0;
    int pendingTickets = ViewBag.PendingSupportTickets ?? 0;
    int totalHistory = ViewBag.TotalApprovalHistory ?? 0;
    int lockedUsers = ViewBag.LockedUsers ?? 0;
    int unreadNotifications = ViewBag.UnreadNotifications ?? 0;
    int urgentCount = pendingRooms + pendingTickets;
}

<div class="dashboard-page">
    <div class="dashboard-shell">
        <header class="dashboard-heading">
            <div>
                <span class="dashboard-heading__label"><i class="fas fa-shield-halved"></i> Trung tâm quản trị</span>
                <h1>Tổng quan hệ thống</h1>
                <p>Những việc cần xử lý được ưu tiên trước, các chức năng còn lại được gom gọn bên dưới.</p>
            </div>
            <div class="dashboard-heading__actions">
                <a href="/Admin/CreateRoom" class="btn btn-outline-primary"><i class="fas fa-plus"></i> Đăng tin hộ</a>
                <a href="/Admin/PendingPosts" class="btn btn-primary"><i class="fas fa-list-check"></i> Duyệt bài ngay</a>
            </div>
        </header>

        <section class="dashboard-metrics" aria-label="Số liệu tổng quan">
            <a href="/Admin/ManageUsers" class="dashboard-metric">
                <span class="dashboard-metric__icon is-blue"><i class="fas fa-users"></i></span>
                <span><small>Người dùng</small><strong>@totalUsers</strong><em>@totalLandlords chủ trọ · @totalTenants người thuê</em></span>
            </a>
            <a href="/Admin/ManagePosts?status=approved" class="dashboard-metric">
                <span class="dashboard-metric__icon is-green"><i class="fas fa-circle-check"></i></span>
                <span><small>Bài đã duyệt</small><strong id="approvedCount">@approvedRooms</strong><em>Đang hiển thị công khai</em></span>
            </a>
            <a href="/Admin/PendingPosts" class="dashboard-metric is-urgent">
                <span class="dashboard-metric__icon is-orange"><i class="fas fa-hourglass-half"></i></span>
                <span><small>Chờ duyệt</small><strong id="pendingCount">@pendingRooms</strong><em>Cần kiểm tra sớm</em></span>
            </a>
            <a href="/Admin/ManagePosts" class="dashboard-metric">
                <span class="dashboard-metric__icon is-dark"><i class="fas fa-building"></i></span>
                <span><small>Tổng tin đăng</small><strong>@totalRooms</strong><em>@rejectedRooms tin bị từ chối</em></span>
            </a>
        </section>

        <div class="dashboard-priority-grid">
            <section class="dashboard-priority">
                <div class="dashboard-section-heading">
                    <div>
                        <span class="dashboard-section-heading__icon is-orange"><i class="fas fa-bolt"></i></span>
                        <div><h2>Cần xử lý ngay</h2><p>Ưu tiên các mục mới để hệ thống vận hành trơn tru.</p></div>
                    </div>
                    @if (urgentCount > 0) { <span class="dashboard-count-badge">@urgentCount việc</span> }
                </div>
                <div class="dashboard-task-list">
                    <a href="/Admin/PendingPosts" class="dashboard-task is-primary">
                        <span class="dashboard-task__icon"><i class="fas fa-file-circle-check"></i></span>
                        <span><strong>Duyệt bài đăng mới</strong><small>@pendingRooms bài đang chờ kiểm tra hồ sơ và nội dung</small></span>
                        <b>@pendingRooms</b><i class="fas fa-chevron-right"></i>
                    </a>
                    <a href="/Admin/SupportTickets" class="dashboard-task">
                        <span class="dashboard-task__icon"><i class="fas fa-headset"></i></span>
                        <span><strong>Yêu cầu hỗ trợ chưa xử lý</strong><small>Phản hồi người dùng và khiếu nại mới</small></span>
                        <b>@pendingTickets</b><i class="fas fa-chevron-right"></i>
                    </a>
                    <a href="/Admin/ManageUsers?status=locked" class="dashboard-task">
                        <span class="dashboard-task__icon"><i class="fas fa-user-lock"></i></span>
                        <span><strong>Tài khoản đang khóa</strong><small>Kiểm tra trạng thái và lý do khóa</small></span>
                        <b>@lockedUsers</b><i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </section>

            <section class="dashboard-latest">
                <div class="dashboard-section-heading">
                    <div>
                        <span class="dashboard-section-heading__icon is-blue"><i class="fas fa-bell"></i></span>
                        <div><h2>Thông báo mới nhất</h2><p id="dashboardUnreadNotificationCount">@(unreadNotifications == 0 ? "Tất cả thông báo đã đọc" : $"{unreadNotifications} thông báo chưa đọc")</p></div>
                    </div>
                    <button type="button" class="dashboard-icon-button" onclick="document.getElementById('notificationDropdownButton')?.click()" aria-label="Mở tất cả thông báo"><i class="fas fa-arrow-up-right-from-square"></i></button>
                </div>
                <div class="dashboard-notification-list">
                    @foreach (var item in notifications)
                    {
                        <a href="@(item.Url ?? "#")" data-notification-id="@item.Id" class="dashboard-notification @(!item.IsRead ? "is-unread" : "")">
                            <span><i class="fas @(item.Type == "PendingApproval" ? "fa-list-check" : item.Type == "RentalRequest" ? "fa-handshake" : "fa-bell")"></i></span>
                            <span><strong>@item.Title</strong><small>@item.Message</small><time>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time></span>
                        </a>
                    }
                    @if (!notifications.Any()) { <div class="dashboard-empty"><i class="far fa-bell"></i><p>Chưa có thông báo mới.</p></div> }
                </div>
            </section>
        </div>

        <section class="dashboard-accordion">
            <button class="dashboard-accordion__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#adminOperations" aria-expanded="false" aria-controls="adminOperations">
                <span><i class="fas fa-table-cells-large"></i><span><strong>Quản lý & vận hành</strong><small>Tất cả chức năng quản trị được sắp xếp trong một mục</small></span></span>
                <i class="fas fa-chevron-down dashboard-accordion__chevron"></i>
            </button>
            <div class="collapse" id="adminOperations">
                <div class="dashboard-operation-grid">
                    <a href="/Admin/PendingPosts"><i class="fas fa-list-check is-orange"></i><span><strong>Duyệt bài đăng</strong><small>@pendingRooms bài đang chờ</small></span></a>
                    <a href="/Admin/ManagePosts"><i class="fas fa-building is-blue"></i><span><strong>Quản lý bài đăng</strong><small>Toàn bộ @totalRooms tin đăng</small></span></a>
                    <a href="/Admin/ManageUsers"><i class="fas fa-users-gear is-blue"></i><span><strong>Quản lý người dùng</strong><small>Khóa, mở khóa, phân loại</small></span></a>
                    <a href="/Admin/SupportTickets"><i class="fas fa-headset is-red"></i><span><strong>Quản lý hỗ trợ</strong><small>@pendingTickets yêu cầu chưa xử lý</small></span></a>
                    <a href="/Admin/ApprovalHistory"><i class="fas fa-clock-rotate-left is-green"></i><span><strong>Lịch sử xử lý</strong><small>@totalHistory lượt duyệt và từ chối</small></span></a>
                    <a href="/"><i class="fas fa-house is-dark"></i><span><strong>Về trang chủ</strong><small>Xem giao diện công khai</small></span></a>
                </div>
            </div>
        </section>

        <section class="dashboard-table-panel">
            <div class="dashboard-section-heading">
                <div><span class="dashboard-section-heading__icon is-blue"><i class="fas fa-clock-rotate-left"></i></span><div><h2>Hoạt động gần đây</h2><p>Các bài đăng mới nhất trên hệ thống</p></div></div>
                <a href="/Admin/ManagePosts">Xem tất cả <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table dashboard-table align-middle mb-0">
                    <thead><tr><th>Chủ trọ</th><th>Bài đăng</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in recentActivities)
                    {
                        <tr>
                            <td><strong>@item.Owner?.FullName</strong><small>@item.Owner?.Email</small></td>
                            <td><a href="/Accommodation/Details/@item.Id">@item.Title</a></td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="dashboard-status @(item.IsApproved ? "is-success" : item.IsRejected ? "is-danger" : "is-warning")">@(item.IsApproved ? "Đã duyệt" : item.IsRejected ? "Từ chối" : "Chờ duyệt")</span></td>
                            <td><a class="dashboard-row-action" href="@(!item.IsApproved && !item.IsRejected ? "/Admin/PendingPosts" : $"/Accommodation/Details/{item.Id}")">Xem <i class="fas fa-arrow-right"></i></a></td>
                        </tr>
                    }
                    @if (!recentActivities.Any()) { <tr><td colspan="5"><div class="dashboard-empty">Chưa có hoạt động nào.</div></td></tr> }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("pendingAccommodationProcessed", event => {
            const pending = document.getElementById("pendingCount");
            if (pending) pending.textContent = Math.max(0, Number(pending.textContent) - 1);
            if (event.detail.status === "Approved") {
                const approved = document.getElementById("approvedCount");
                if (approved) approved.textContent = Number(approved.textContent) + 1;
            }
        });
        document.addEventListener("pendingAccommodationCreated", () => {
            const pending = document.getElementById("pendingCount");
            if (pending) pending.textContent = Number(pending.textContent) + 1;
        });
    </script>
}
