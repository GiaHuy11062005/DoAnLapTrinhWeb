@model IEnumerable<DoAnLapTrinhWeb.Models.LandlordApplication>
@{
    ViewData["Title"] = "Phê duyệt Chủ trọ";
    Layout = "_AdminLayout";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Duyệt Hồ Sơ Chủ Trọ</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Xem xét và cấp quyền đăng phòng cho người dùng muốn trở thành chủ trọ.</p>
</div>

<div class="bg-white dark:bg-darkCard border border-gray-100 dark:border-gray-800 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Người gửi</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Số điện thoại</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Thời gian</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model != null && Model.Any())
                {
                    foreach (var app in Model)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <div class="h-8 w-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400 font-bold text-xs border border-purple-200 dark:border-purple-800">
                                        @((app.User?.FullName?.Substring(0, 1) ?? "U").ToUpper())
                                    </div>
                                    <div class="ml-3">
                                        <div class="text-sm font-medium text-gray-900 dark:text-white">@(app.User?.FullName ?? "Unknown User")</div>
                                        <div class="text-xs text-gray-500">@(app.User?.Email ?? "N/A")</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @app.Phone
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @app.CreatedAt.ToString("dd/MM/yyyy")
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end space-x-2">
                                    <a href="/Admin/LandlordApplicationDetails/@app.Id" target="_blank" class="p-2 text-gray-400 hover:text-blue-600 bg-gray-50 hover:bg-blue-50 rounded-lg dark:bg-gray-800 dark:hover:bg-gray-700 transition-colors" title="Xem chi tiết hồ sơ">
                                        <i class="fas fa-file-invoice"></i>
                                    </a>
                                    <form action="/Admin/ApproveLandlordApplication" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn Duyệt yêu cầu này không? Tài khoản sẽ trở thành Chủ Trọ ngay lập tức.');">
                                        <input type="hidden" name="id" value="@app.Id" />
                                        <button type="submit" class="p-2 text-gray-400 hover:text-green-600 bg-gray-50 hover:bg-green-50 rounded-lg dark:bg-gray-800 dark:hover:bg-gray-700 transition-colors" title="Duyệt">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                    <form action="/Admin/RejectLandlordApplication" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn Từ chối yêu cầu này không?');">
                                        <input type="hidden" name="id" value="@app.Id" />
                                        <button type="submit" class="p-2 text-gray-400 hover:text-red-600 bg-gray-50 hover:bg-red-50 rounded-lg dark:bg-gray-800 dark:hover:bg-gray-700 transition-colors" title="Từ chối">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center">
                            <i class="fas fa-id-card text-4xl text-purple-400 mb-3 opacity-50"></i>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Không có hồ sơ đăng ký chủ trọ nào chờ duyệt.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
