@model IEnumerable<DoAnLapTrinhWeb.Models.Accommodation>
@{
    ViewData["Title"] = "Phê duyệt Bài đăng";
    Layout = "_AdminLayout";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Duyệt Bài Đăng Phòng Trọ</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Các phòng trọ mới được chủ trọ đăng lên cần admin phê duyệt trước khi hiển thị.</p>
</div>

<div class="bg-white dark:bg-darkCard border border-gray-100 dark:border-gray-800 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-800/50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Thời gian</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Phòng Trọ</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Chủ trọ</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500">
                                @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-gray-900 dark:text-white truncate max-w-[200px]" title="@item.Title">@item.Title</div>
                                <div class="text-xs text-gray-500 mt-1">@item.Price.ToString("N0")đ/tháng</div>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">
                                @(item.Owner?.FullName ?? "N/A")
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end space-x-2">
                                    <a href="/Accommodation/Details/@item.Id" target="_blank" class="p-2 text-gray-400 hover:text-blue-600 bg-gray-50 hover:bg-blue-50 rounded-lg dark:bg-gray-800 dark:hover:bg-gray-700 transition-colors" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form action="/Admin/Approve" method="post" class="inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="p-2 text-gray-400 hover:text-green-600 bg-gray-50 hover:bg-green-50 rounded-lg dark:bg-gray-800 dark:hover:bg-gray-700 transition-colors" title="Duyệt">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="p-2 text-gray-400 hover:text-red-600 bg-gray-50 hover:bg-red-50 rounded-lg dark:bg-gray-800 dark:hover:bg-gray-700 transition-colors" onclick="setRejectId(@item.Id)" title="Từ chối">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center">
                            <i class="fas fa-check-circle text-4xl text-green-400 mb-3 opacity-50"></i>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Không có bài đăng nào đang chờ duyệt.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nhập Lý Do Khóa/Từ chối Bài Đăng Phòng Trọ -->
<div id="rejectModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-900 bg-opacity-75 transition-opacity backdrop-blur-sm" aria-hidden="true" onclick="closeRejectModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white dark:bg-darkCard rounded-xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full border border-gray-200 dark:border-gray-700">
            <form action="/Admin/RejectAccommodation" method="post">
                <div class="px-6 py-5 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center">
                    <h3 class="text-lg leading-6 font-semibold text-gray-900 dark:text-white" id="modal-title">Từ chối bài đăng</h3>
                    <button type="button" class="text-gray-400 hover:text-gray-500 focus:outline-none" onclick="closeRejectModal()">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                <div class="px-6 py-5">
                    <input type="hidden" name="id" id="rejectAccommodationId" value="" />
                    <div class="mt-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Lý do từ chối (hiển thị cho chủ trọ):</label>
                        <textarea name="reason" rows="3" class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 dark:border-gray-600 rounded-md dark:bg-gray-800 dark:text-white p-3 border" placeholder="Ví dụ: Hình ảnh không rõ ràng, giá sai..." required></textarea>
                    </div>
                </div>
                <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800/50 border-t border-gray-100 dark:border-gray-800 flex justify-end space-x-3">
                    <button type="button" class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none" onclick="closeRejectModal()">Hủy</button>
                    <button type="submit" class="px-4 py-2 bg-red-600 border border-transparent rounded-lg text-sm font-medium text-white hover:bg-red-700 focus:outline-none shadow-sm shadow-red-500/30">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rejectModal = document.getElementById('rejectModal');
        function setRejectId(id) {
            document.getElementById('rejectAccommodationId').value = id;
            rejectModal.classList.remove('hidden');
        }
        function closeRejectModal() {
            rejectModal.classList.add('hidden');
        }
    </script>
}
