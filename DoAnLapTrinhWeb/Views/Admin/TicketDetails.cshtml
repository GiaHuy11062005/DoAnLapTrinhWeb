@model DoAnLapTrinhWeb.Models.SupportTicket
@{
    ViewData["Title"] = "Chi tiết yêu cầu hỗ trợ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <a href="/Admin/SupportTickets" class="text-decoration-none text-muted">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row g-4">
        <!-- Thông tin chi tiết -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-file-alt text-primary me-2"></i> Nội dung yêu cầu</h5>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark px-3 py-2"><i class="fas fa-clock me-1"></i> Chờ xử lý</span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <span class="badge bg-danger px-3 py-2"><i class="fas fa-times me-1"></i> Bị từ chối</span>
                    }
                    else
                    {
                        <span class="badge bg-success px-3 py-2"><i class="fas fa-check me-1"></i> Đã giải quyết</span>
                    }
                </div>
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">@Model.Subject</h4>
                    <div class="bg-light p-4 rounded-3 mb-4" style="white-space: pre-wrap; font-size: 1.05rem; line-height: 1.6;">@Model.Message</div>

                    @if (!string.IsNullOrEmpty(Model.AttachedImagePath))
                    {
                        var images = Model.AttachedImagePath.Split('|');
                        <h6 class="fw-bold mb-3"><i class="fas fa-paperclip me-2"></i> Ảnh đính kèm (@images.Length ảnh):</h6>
                        <div class="row g-3">
                            @foreach (var img in images)
                            {
                                <div class="col-md-6 col-12 text-center bg-light p-3 rounded border">
                                    <img src="@img" class="img-fluid rounded shadow-sm" style="max-height: 300px; object-fit: contain;" alt="Ảnh đính kèm" />
                                    <div class="mt-3">
                                        <a href="@img" target="_blank" class="btn btn-outline-secondary btn-sm">
                                            <i class="fas fa-external-link-alt me-1"></i> Mở ảnh gốc
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Thông tin người gửi & Xử lý -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-user-circle text-info me-2"></i> Người gửi</h6>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Họ tên:</strong> @Model.FullName</p>
                    <p class="mb-2"><strong>Email:</strong> <a href="mailto:@Model.Email">@Model.Email</a></p>
                    <p class="mb-2"><strong>Thời gian:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    @if (Model.UserId.HasValue)
                    {
                        <p class="mb-0"><strong>Tài khoản:</strong> <span class="badge bg-secondary">ID: @Model.UserId</span></p>
                    }
                    else
                    {
                        <p class="mb-0"><strong>Tài khoản:</strong> <span class="text-muted fst-italic">Khách vãng lai</span></p>
                    }
                </div>
            </div>

            @if (Model.Status == "Pending")
            {
                <div class="card shadow-sm border-0 border-top border-success border-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-success"><i class="fas fa-reply me-2"></i> Phản hồi & Xử lý</h6>
                    </div>
                    <div class="card-body">
                        <form id="resolveForm" asp-action="ResolveTicket" asp-controller="Admin" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Phản hồi lại người dùng (Tùy chọn)</label>
                                <textarea name="responseMessage" class="form-control" rows="4" placeholder="Nhập tin nhắn phản hồi báo cho người dùng biết bạn đã xử lý xong..."></textarea>
                                <div class="form-text small">Tin nhắn này sẽ được gửi dưới dạng thông báo (Notification) đến người dùng.</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success flex-fill fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#acceptModal">
                                    <i class="fas fa-check-circle me-2"></i> Chấp nhận
                                </button>
                                <button type="button" class="btn btn-danger flex-fill fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                    <i class="fas fa-times-circle me-2"></i> Từ chối
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 border-top border-4 @(Model.Status == "Resolved" ? "border-success" : "border-danger")">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="mb-0 fw-bold @(Model.Status == "Resolved" ? "text-success" : "text-danger")">
                            <i class="fas fa-reply me-2"></i> Phản hồi từ Admin
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.AdminResponse))
                        {
                            <div class="p-3 bg-light rounded text-break" style="font-size: 0.95rem;">
                                @Html.Raw(Model.AdminResponse.Replace("\n", "<br />"))
                            </div>
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-0">Admin đã xử lý yêu cầu này nhưng không để lại lời nhắn.</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.Status == "Pending")
{
    <!-- Accept Modal -->
    <div class="modal fade" id="acceptModal" tabindex="-1" aria-labelledby="acceptModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold" id="acceptModalLabel"><i class="fas fa-check-circle me-2"></i>Xác nhận Chấp nhận</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <i class="fas fa-question-circle fa-4x text-success mb-3 opacity-50"></i>
                    <p class="fs-5 mb-0">Bạn có chắc chắn muốn <strong>ĐỒNG Ý</strong> và đánh dấu đã xử lý xong yêu cầu này không?</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" form="resolveForm" name="actionType" value="Resolve" class="btn btn-success px-4 fw-bold">Có, Chấp nhận</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title fw-bold" id="rejectModalLabel"><i class="fas fa-times-circle me-2"></i>Xác nhận Từ chối</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <i class="fas fa-exclamation-triangle fa-4x text-danger mb-3 opacity-50"></i>
                    <p class="fs-5 mb-0">Bạn có chắc chắn muốn <strong>TỪ CHỐI</strong> yêu cầu này không?</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" form="resolveForm" name="actionType" value="Reject" class="btn btn-danger px-4 fw-bold">Có, Từ chối</button>
                </div>
            </div>
        </div>
    </div>
}
