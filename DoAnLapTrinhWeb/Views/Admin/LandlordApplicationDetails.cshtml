@model DoAnLapTrinhWeb.Models.LandlordApplication
@using System.Linq
@{
    ViewData["Title"] = "Chi tiết hồ sơ chủ trọ";
    var supportingDocs = Model.SupportingDocumentUrlList?.ToList() ?? new List<string>();
}

<div class="container py-5">
    <div class="detail-shell mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <span class="section-kicker">Hồ sơ</span>
                <h1 class="section-title mb-2">Chi tiết đăng ký làm chủ trọ</h1>
                <p class="text-muted mb-0">Xem kỹ thông tin và ảnh trước khi phê duyệt hoặc từ chối.</p>
            </div>
            <a href="/Admin" class="btn btn-outline-secondary rounded-pill">
                <i class="fas fa-arrow-left me-2"></i>Quay lại Dashboard
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="detail-card h-100">
                <h2 class="h5 fw-bold mb-3">Thông tin người đăng ký</h2>
                <div class="info-row"><span>Họ tên</span><strong>@Model.User?.FullName</strong></div>
                <div class="info-row"><span>Email</span><strong>@Model.User?.Email</strong></div>
                <div class="info-row"><span>SĐT</span><strong>@Model.Phone</strong></div>
                <div class="info-row"><span>Ngày gửi</span><strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
                <div class="info-row"><span>Trạng thái</span><strong>@Model.Status</strong></div>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="mt-3">
                        <div class="fw-semibold mb-2">Ghi chú</div>
                        <div class="text-muted">@Model.Note</div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-8">
            <div class="detail-card mb-4">
                <h2 class="h5 fw-bold mb-3">Ảnh CCCD</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="document-box">
                            <div class="fw-semibold mb-2">Mặt trước</div>
                            @if (!string.IsNullOrWhiteSpace(Model.CitizenIdFrontImageUrl))
                            {
                                <img src="@Model.CitizenIdFrontImageUrl" alt="CCCD mặt trước" class="img-fluid rounded-4" />
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="document-box">
                            <div class="fw-semibold mb-2">Mặt sau</div>
                            @if (!string.IsNullOrWhiteSpace(Model.CitizenIdBackImageUrl))
                            {
                                <img src="@Model.CitizenIdBackImageUrl" alt="CCCD mặt sau" class="img-fluid rounded-4" />
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="detail-card mb-4">
                <h2 class="h5 fw-bold mb-3">Giấy tờ bổ sung</h2>
                @if (supportingDocs.Any())
                {
                    <div class="row g-3">
                        @foreach (var doc in supportingDocs)
                        {
                            <div class="col-md-6">
                                <div class="document-box">
                                    <img src="@doc" alt="Giấy tờ bổ sung" class="img-fluid rounded-4" />
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border mb-0">Hồ sơ này chưa có giấy tờ bổ sung.</div>
                }
            </div>

            <div class="detail-card">
                <h2 class="h5 fw-bold mb-3">Phê duyệt hồ sơ</h2>
                <div class="d-flex flex-wrap gap-2">
                    <form action="/Admin/ApproveLandlordApplication" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success btn-lg rounded-pill px-4">
                            <i class="fas fa-check me-2"></i>Phê duyệt
                        </button>
                    </form>

                    <form action="/Admin/RejectLandlordApplication" method="post" class="flex-grow-1">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Lý do từ chối</label>
                                <input type="text" name="rejectionReason" class="form-control form-control-lg" placeholder="Ví dụ: Ảnh giấy tờ chưa rõ, thiếu thông tin...">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-danger btn-lg rounded-pill w-100">
                                    <i class="fas fa-times me-2"></i>Từ chối
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-shell,
    .detail-card {
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 28px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
        padding: 1.75rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.8rem 0;
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    }

    .info-row span {
        color: #64748b;
    }

    .info-row strong {
        text-align: right;
        color: #0f172a;
    }

    .document-box {
        padding: 1rem;
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 20px;
        background: #fff;
    }
</style>
