@model IEnumerable<DoAnLapTrinhWeb.Models.SupportTicket>
@{
    ViewData["Title"] = "Lịch sử yêu cầu hỗ trợ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-list-alt text-primary me-2"></i> Lịch sử yêu cầu hỗ trợ của bạn</h2>
        <a href="/Support/Create" class="btn btn-primary shadow-sm"><i class="fas fa-plus me-1"></i> Gửi yêu cầu mới</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Ngày gửi</th>
                            <th>Tiêu đề</th>
                            <th>Nội dung</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3 text-light"></i>
                                    <p class="mb-0 fs-5">Bạn chưa có yêu cầu hỗ trợ nào.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var ticket in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="small fw-bold">@ticket.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        <div class="small text-muted">@ticket.CreatedAt.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-truncate" style="max-width: 200px;" title="@ticket.Subject">@ticket.Subject</div>
                                    </td>
                                    <td>
                                        <div class="small text-muted text-truncate" style="max-width: 350px;" title="@ticket.Message">@ticket.Message</div>
                                    </td>
                                    <td>
                                        @if (ticket.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i> Chờ xử lý</span>
                                        }
                                        else if (ticket.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times me-1"></i> Đã bị từ chối</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i> Đã giải quyết</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="/Support/TicketDetails/@ticket.Id" class="btn btn-sm btn-outline-info shadow-sm">
                                            <i class="fas fa-info-circle"></i> Xem chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
