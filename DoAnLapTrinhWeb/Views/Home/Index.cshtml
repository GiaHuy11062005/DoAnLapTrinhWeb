@{
    ViewData["Title"] = "Trang chủ";
}

@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <div class="container mt-5 text-center mb-5">
        <div class="p-5 bg-light rounded shadow-sm border border-primary border-opacity-25">
            <h2 class="text-primary fw-bold mb-3"><i class="fas fa-user-shield"></i> Xin chào Quản Trị Viên</h2>
            <p class="fs-5 text-muted">Bạn đang ở trang chủ dành cho Admin. Vui lòng truy cập trang quản trị để duyệt bài đăng mới và quản lý hệ thống.</p>
            <a href="/Admin" class="btn btn-primary btn-lg mt-4 px-5 rounded-pill shadow">
                Đi đến Dashboard Quản Trị <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
}
else if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Landlord"))
{
    <div class="container mt-5 text-center mb-5">
        <div class="p-5 bg-light rounded shadow-sm border border-success border-opacity-25">
            <h2 class="text-success fw-bold mb-3"><i class="fas fa-house-user"></i> Xin chào Chủ Trọ</h2>
            <p class="fs-5 text-muted">Chào mừng bạn quay trở lại. Hãy quản lý các phòng trọ của bạn hoặc đăng tin mới ngay hôm nay để tiếp cận hàng ngàn người thuê.</p>
            <div class="mt-4">
                <button class="btn btn-success btn-lg px-4 me-3 rounded-pill shadow" data-bs-toggle="modal" data-bs-target="#postAccommodationModal">
                    <i class="fas fa-plus-circle me-2"></i> Đăng tin cho thuê mới
                </button>
                <!-- ĐÃ SỬA ĐƯỜNG DẪN Ở ĐÂY TỪ "#" THÀNH "/Accommodation/Index" -->
                <a href="/Accommodation/Index" class="btn btn-outline-success btn-lg px-4 rounded-pill shadow">
                    <i class="fas fa-list-ul me-2"></i> Quản lý phòng đã đăng
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="bg-light py-5" style="background: url('/images/hero-bg.jpg') center/cover; min-height: 500px; display: flex; align-items: center;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-10 text-center bg-white p-5 rounded shadow-lg" style="opacity: 0.95;">
                    <h1 class="fw-bold text-dark mb-4">Tìm kiếm chỗ ở lý tưởng của bạn</h1>
                    
                    <form action="/Accommodation/Search" method="GET" class="row g-3">
                        <div class="col-md-3">
                            <select class="form-select form-select-lg" id="citySelect" name="cityId" required>
                                <option value="" selected disabled>-- Chọn Tỉnh/Thành --</option>
                                @if (ViewBag.Cities != null)
                                {
                                    foreach (var city in ViewBag.Cities)
                                    {
                                        <option value="@city.Id">@city.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-lg" id="districtSelect" name="districtId" disabled required>
                                <option value="" selected disabled>-- Chọn Quận/Huyện --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-lg" name="priceRange">
                                <option value="" selected disabled>-- Mức giá --</option>
                                <option value="1">Dưới 2 triệu</option>
                                <option value="2">2 - 4 triệu</option>
                                <option value="3">Trên 4 triệu</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-search"></i> Tìm kiếm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.SuggestedRooms != null && ViewBag.SuggestedRooms.Count > 0)
    {
        <div class="container mt-5 mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold"><i class="fas fa-map-marker-alt text-danger"></i> Đề xuất trọ gần bạn nhất</h3>
                <a href="#" class="text-decoration-none">Xem tất cả <i class="fas fa-angle-right"></i></a>
            </div>
            
            <div class="row">
                @foreach (DoAnLapTrinhWeb.Models.Accommodation room in ViewBag.SuggestedRooms)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm border-0 transition-hover">
                            @{
                                var firstImage = (room.Images != null && room.Images.Any())
                                    ? room.Images.First().ImageUrl
                                    : "/images/default-room.jpg";
                            }
                            <img src="@firstImage" class="card-img-top" alt="@room.Title" style="height: 220px; object-fit: cover; border-radius: 8px 8px 0 0;">
                            
                            <div class="card-body">
                                <h5 class="card-title text-truncate fw-bold" title="@room.Title">@room.Title</h5>
                                <p class="card-text text-danger fw-bold fs-5 mb-2">@room.Price.ToString("N0") VNĐ/tháng</p>
                                
                                <p class="card-text text-muted small mb-1">
                                    <i class="fas fa-expand-arrows-alt"></i> Diện tích: @room.Area m²
                                </p>
                                <p class="card-text text-muted small text-truncate" title="@room.SpecificAddress">
                                    <i class="fas fa-map-pin"></i> @room.SpecificAddress
                                </p>
                            </div>
                            
                            <div class="card-footer bg-white border-top-0 pb-3">
                                <a href="/Accommodation/Details/@room.Id" class="btn btn-outline-primary w-100 rounded-pill">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<style>
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const citySelect = document.getElementById("citySelect");
            const districtSelect = document.getElementById("districtSelect");

            // Bắt sự kiện khi người dùng thay đổi Thành phố ở Form tìm kiếm
            if (citySelect && districtSelect) {
                citySelect.addEventListener("change", async function () {
                    const cityId = this.value;

                    // Reset lại dropdown Quận/Huyện
                    districtSelect.innerHTML = '<option value="" selected disabled>-- Đang tải... --</option>';
                    districtSelect.disabled = true;

                    if (!cityId) return;

                    try {
                        // Gọi API bất đồng bộ để lấy danh sách Quận/Huyện có phòng
                        const response = await fetch(`/Home/GetDistrictsWithRooms?cityId=${cityId}`);
                        
                        if (!response.ok) throw new Error("Lỗi mạng khi tải dữ liệu");
                        
                        const districts = await response.json();

                        // Xóa option "Đang tải..."
                        districtSelect.innerHTML = '<option value="" selected disabled>-- Chọn Quận/Huyện --</option>';

                        if (districts.length > 0) {
                            // Mở khóa dropdown và đổ dữ liệu vào
                            districts.forEach(d => {
                                const option = document.createElement("option");
                                option.value = d.id;
                                option.textContent = d.name;
                                districtSelect.appendChild(option);
                            });
                            districtSelect.disabled = false;
                        } else {
                            // Nếu không có quận huyện nào có phòng
                            districtSelect.innerHTML = '<option value="" selected disabled>Hiện chưa có phòng tại khu vực này</option>';
                        }
                    } catch (error) {
                        console.error("Lỗi:", error);
                        districtSelect.innerHTML = '<option value="" selected disabled>Lỗi tải dữ liệu</option>';
                    }
                });
            }
        });
    </script>
}