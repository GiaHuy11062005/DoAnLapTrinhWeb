@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const citySelect = document.getElementById("citySelect");
            const districtSelect = document.getElementById("districtSelect");
            const wardSelect = document.getElementById("wardSelect");

            // =============================================
            // Load Quận/Huyện khi chọn Tỉnh/Thành phố
            // =============================================
            if (citySelect && districtSelect) {
                citySelect.addEventListener("change", async function () {
                    const cityId = this.value;

                    // Reset District
                    districtSelect.innerHTML = '<option value="" selected disabled>-- Đang tải... --</option>';
                    districtSelect.disabled = true;

                    // Reset Ward
                    if (wardSelect) {
                        wardSelect.innerHTML = '<option value="" selected>-- Chọn Phường/Xã --</option>';
                        wardSelect.disabled = true;
                    }

                    if (!cityId) return;

                    try {
                        const response = await fetch(`/Home/GetDistrictsWithRooms?cityId=${cityId}`);
                        if (!response.ok) throw new Error("Lỗi mạng khi tải dữ liệu");

                        const districts = await response.json();
                        districtSelect.innerHTML = '<option value="" selected disabled>-- Chọn Quận/Huyện --</option>';

                        if (districts.length > 0) {
                            districts.forEach(d => {
                                const option = document.createElement("option");
                                option.value = d.id;
                                option.textContent = d.name;
                                districtSelect.appendChild(option);
                            });
                            districtSelect.disabled = false;
                        } else {
                            districtSelect.innerHTML = '<option value="" selected disabled>Hiện chưa có phòng tại khu vực này</option>';
                        }
                    } catch (error) {
                        console.error("Lỗi:", error);
                        districtSelect.innerHTML = '<option value="" selected disabled>Lỗi tải dữ liệu</option>';
                    }
                });
            }

            // =============================================
            // Load Phường/Xã khi chọn Quận/Huyện
            // =============================================
            if (districtSelect && wardSelect) {
                districtSelect.addEventListener("change", async function () {
                    const districtId = this.value;

                    wardSelect.innerHTML = '<option value="" selected>-- Đang tải... --</option>';
                    wardSelect.disabled = true;

                    if (!districtId) return;

                    try {
                        const response = await fetch(`/Accommodation/GetAllWards?districtId=${districtId}`);
                        if (!response.ok) throw new Error("Lỗi mạng");

                        const wards = await response.json();
                        wardSelect.innerHTML = '<option value="" selected>-- Chọn Phường/Xã (tùy chọn) --</option>';

                        if (wards.length > 0) {
                            wards.forEach(w => {
                                const option = document.createElement("option");
                                option.value = w.id;
                                option.textContent = w.name;
                                wardSelect.appendChild(option);
                            });
                            wardSelect.disabled = false;
                        } else {
                            wardSelect.innerHTML = '<option value="" selected>-- Chưa có dữ liệu Phường/Xã --</option>';
                        }
                    } catch (error) {
                        console.error("Lỗi tải Phường/Xã:", error);
                        wardSelect.innerHTML = '<option value="" selected>Lỗi tải dữ liệu</option>';
                    }
                });
            }
            });
    </script>
}

