        color: #94a3b8; font-size: 0.9rem; cursor: pointer; line-height: 1;
    }
    .history-tag .remove-btn:hover { color: #ef4444; }
</style>

<script>
// === CHỨC NĂNG 1: Tab chọn loại hình (Nhà trọ / Nhà nguyên căn) ===
function selectHouseType(type) {
    document.getElementById('houseTypeInput').value = type;

    const tabs = document.querySelectorAll('.house-type-tab');
    tabs.forEach(t => {
        t.classList.remove('active-tab', 'btn-primary');
        t.classList.add('btn-outline-secondary');
    });

    const activeBtn = type === 'phong-tro'
        ? document.getElementById('tabPhongTro')
        : document.getElementById('tabNguyenCan');

    activeBtn.classList.add('active-tab', 'btn-primary');
    activeBtn.classList.remove('btn-outline-secondary');

    // Khi chọn Nhà nguyên căn: đẩy Nhà trọ qua, thay đổi placeholder tìm kiếm
    const cityLabel = document.querySelector('#citySelect')?.closest('.col-12');
    if (type === 'nguyen-can') {
        document.querySelector('label[for="citySelect"], #citySelect')?.previousElementSibling;
        // Highlight form với màu khác cho Nhà nguyên căn
        document.querySelector('.hero-search').style.background = 'rgba(254, 243, 199, 0.92)';
        document.querySelector('.hero-search').style.borderColor = 'rgba(251,191,36,0.35)';
        // Cập nhật tiêu đề nếu có
        const badge = document.querySelector('.section-kicker');
        if (badge) badge.setAttribute('data-prev', badge.textContent);
    } else {
        document.querySelector('.hero-search').style.background = '';
        document.querySelector('.hero-search').style.borderColor = '';
        const badge = document.querySelector('.section-kicker');
        if (badge && badge.getAttribute('data-prev')) {
            badge.textContent = badge.getAttribute('data-prev');
        }
    }
}

// === CHỨC NĂNG 2: Lịch sử tìm kiếm (localStorage, áp dụng mọi role) ===
const HISTORY_KEY = 'searchHistory_v1';

function getHistory() {
    try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); }
    catch { return []; }
}

function saveHistory(hist) {
    localStorage.setItem(HISTORY_KEY, JSON.stringify(hist));
}

function renderHistory() {
    const hist = getHistory();
    const box = document.getElementById('searchHistoryBox');
    const list = document.getElementById('searchHistoryList');
    if (!box || !list) return;

    if (hist.length === 0) {
        box.style.display = 'none';
        return;
    }

    box.style.display = '';
    list.innerHTML = hist.map((h, i) =>
        `<span class="history-tag" onclick="applyHistory(${i})">
            <i class="fas fa-map-marker-alt"></i>
            ${h.label}
            <button class="remove-btn" onclick="event.stopPropagation(); removeHistoryItem(${i});" title="Xóa">&#10005;</button>
        </span>`
    ).join('');
}

function addToHistory(label, url) {
    let hist = getHistory();
    // Tránh trùng lặp
    hist = hist.filter(h => h.label !== label);
    hist.unshift({ label, url, time: Date.now() });
    if (hist.length > 8) hist = hist.slice(0, 8); // Giới hạn 8 mục
    saveHistory(hist);
}

function applyHistory(index) {
    const hist = getHistory();
    if (hist[index]) window.location.href = hist[index].url;
}

function removeHistoryItem(index) {
    let hist = getHistory();
    hist.splice(index, 1);
    saveHistory(hist);
    renderHistory();
}

function clearSearchHistory() {
    if (confirm('Bạn có chắc muốn xóa toàn bộ lịch sử tìm kiếm không?')) {
        localStorage.removeItem(HISTORY_KEY);
        renderHistory();
    }
}

// Gắn sự kiện: Khi submit form tìm kiếm thì lưu lịch sử
document.addEventListener('DOMContentLoaded', function () {
    renderHistory();

    const searchForm = document.querySelector('form[action="/Accommodation/Search"]');
    if (searchForm) {
        searchForm.addEventListener('submit', function () {
            const cityEl = document.getElementById('citySelect');
            const districtEl = document.getElementById('districtSelect');
            const cityText = cityEl?.options[cityEl.selectedIndex]?.text || '';
            const districtText = districtEl?.options[districtEl?.selectedIndex]?.text || '';

            if (cityText && !cityText.includes('Chọn')) {
                const label = districtText && !districtText.includes('Chọn')
                    ? `${cityText} – ${districtText}`
                    : cityText;
                const url = searchForm.action + '?' + new URLSearchParams(new FormData(searchForm)).toString();
                addToHistory(label, url);
            }
        });
    }
});
</script>

